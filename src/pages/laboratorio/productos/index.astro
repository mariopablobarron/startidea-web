---
// /laboratorio/productos — Productos autoservicio de Startidea: los planes de
// negocio en abierto, ordenados por rentabilidad esperada. Cada ficha vive en
// src/content/productos/ (colección `productos`).
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { breadcrumbList, SITE_URL } from '@/lib/jsonld';

const all = await getCollection('productos', ({ data }) => !data.draft);
all.sort((a, b) => a.data.orden - b.data.orden);

const jsonLd = [
  breadcrumbList([
    { name: 'Inicio', url: `${SITE_URL}/` },
    { name: 'Laboratorio', url: `${SITE_URL}/laboratorio` },
    { name: 'Productos autoservicio', url: `${SITE_URL}/laboratorio/productos` },
  ]),
];

const categorias = Array.from(new Set(all.map((p) => p.data.categoria))).sort();
const estados = Array.from(new Set(all.map((p) => p.data.estado)));

const principios = [
  {
    t: 'Se paga sin hablar con nadie',
    d: 'Alta, uso y cobro sin intervención humana. Si un producto necesita una llamada para venderse, no es autoservicio.',
  },
  {
    t: 'Lo construye la IA, lo firma Startidea',
    d: 'Código, contenido y operación se generan con agentes de IA sobre la plataforma de Startidea. El criterio, la revisión y la responsabilidad son de personas.',
  },
  {
    t: 'Rentable desde el primer cliente',
    d: 'Cada producto tiene su coste variable calculado. Si el margen bruto no supera el 70 %, no se lanza.',
  },
  {
    t: 'La persona siempre aprueba',
    d: 'Nada se publica, se envía ni se presenta sin una aprobación explícita de la organización. La IA propone; la entidad decide.',
  },
];
---

<Base
  title="Productos autoservicio — Laboratorio · Startidea"
  description="Los diez productos autoservicio que Startidea está construyendo con IA, con su plan de negocio en abierto: problema, cliente, precio, margen, hoja de ruta y riesgos. Ordenados por rentabilidad."
  ogSlug="page/laboratorio-productos"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="border-b border-ink/15 bg-paper py-16 md:py-24 lg:py-28">
    <div class="container-x">
      <p class="font-mono text-[11px] uppercase tracking-widest text-ink-mute">
        <a href="/laboratorio" class="link-underline text-ink/70 hover:text-ink">← Laboratorio</a>
      </p>
      <span class="label mt-6 block">— Laboratorio · Productos autoservicio</span>
      <h1 class="mt-4 font-display text-display-xl leading-[0.96] text-ink">
        Diez productos.<br/>
        <em class="italic text-magenta">Diez planes en abierto.</em>
      </h1>
      <p class="mt-8 max-w-measure text-lede text-ink/80">
        Startidea está convirtiendo lo que hace a mano para clientes en productos que una organización pequeña puede contratar, usar y pagar sin hablar con nadie. Todos se construyen con IA sobre la misma plataforma. Aquí están los planes de negocio completos, ordenados por rentabilidad esperada, con sus cifras, sus riesgos y lo que falta para lanzarlos.
      </p>
      <p class="mt-4 max-w-measure font-mono text-xs leading-relaxed text-ink-mute">
        Los precios son objetivo de lanzamiento y pueden cambiar tras las betas. El orden se revisa cada trimestre.
      </p>
    </div>
  </section>

  <!-- Principios -->
  <section class="bg-paper-warm py-14 md:py-20">
    <div class="container-x">
      <div class="grid grid-cols-12 gap-x-8 gap-y-8">
        <div class="col-span-12 lg:col-span-3">
          <span class="label">— Cuatro reglas</span>
          <h2 class="mt-4 font-display text-3xl leading-tight text-ink md:text-4xl">
            Qué tiene que cumplir <em class="italic text-magenta">cada producto</em>.
          </h2>
        </div>
        <ol class="col-span-12 grid gap-px border-2 border-ink/15 bg-ink/15 sm:grid-cols-2 lg:col-span-9">
          {principios.map((p, i) => (
            <li class="bg-paper p-6 md:p-7">
              <span class="num-edit text-3xl">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-3 font-display text-xl leading-tight text-ink">{p.t}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink/75">{p.d}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Ranking -->
  <section class="bg-paper py-16 md:py-24">
    <div class="container-x">
      <!-- Filtros -->
      <div class="grid grid-cols-12 gap-x-8 gap-y-4 border-y border-ink/15 py-6">
        <div class="col-span-12 lg:col-span-3">
          <span class="label">— Filtrar</span>
        </div>
        <div class="col-span-12 flex flex-wrap items-center gap-x-6 gap-y-3 font-mono text-[11px] uppercase tracking-widest lg:col-span-9">
          <span class="text-ink-mute">Área:</span>
          <button data-filter="categoria" data-value="" class="filter-pill active">Todas</button>
          {categorias.map((c) => (
            <button data-filter="categoria" data-value={c} class="filter-pill">{c}</button>
          ))}
          <span class="ml-4 text-ink-mute">Estado:</span>
          <button data-filter="estado" data-value="" class="filter-pill active">Todos</button>
          {estados.map((e) => (
            <button data-filter="estado" data-value={e} class="filter-pill">{e}</button>
          ))}
        </div>
      </div>

      <ol id="productos-list" class="mt-12 divide-y divide-ink/15 border-y border-ink/15">
        {all.map((p) => (
          <li data-categoria={p.data.categoria} data-estado={p.data.estado} class="producto-item">
            <a href={`/laboratorio/productos/${p.slug}`} class="reveal group grid grid-cols-12 gap-x-8 gap-y-4 py-10 transition-colors hover:bg-paper-warm">
              <div class="col-span-12 lg:col-span-3">
                <span class="num-edit text-5xl md:text-6xl">{String(p.data.orden).padStart(2, '0')}</span>
                <p class="mt-3 font-mono text-[11px] uppercase tracking-widest text-ink-mute">
                  Rentabilidad
                  <span class="ml-2 text-magenta" aria-label={`${p.data.rentabilidad} de 5`}>
                    {'●'.repeat(p.data.rentabilidad)}<span class="text-ink/20">{'●'.repeat(5 - p.data.rentabilidad)}</span>
                  </span>
                </p>
              </div>
              <div class="col-span-12 lg:col-span-7">
                <h2 class="font-display text-2xl leading-tight text-ink transition-colors group-hover:text-magenta md:text-3xl">
                  {p.data.title}
                </h2>
                <p class="mt-2 font-display text-lg italic text-ink/70">{p.data.claim}</p>
                <p class="mt-3 max-w-measure text-ink/75">{p.data.description}</p>
                <div class="mt-4 flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-wider">
                  {p.data.alta_url && (
                    <span class="border border-magenta bg-magenta px-2 py-0.5 text-paper">Ya se puede usar</span>
                  )}
                  <span class="border border-magenta/40 px-2 py-0.5 text-magenta">{p.data.categoria}</span>
                  <span class="border border-ink/30 px-2 py-0.5 text-ink/70">{p.data.estado}</span>
                  <span class="border border-ink/30 px-2 py-0.5 text-ink/70">Base en el HUB: {p.data.base_hub}</span>
                  {p.data.beta && <span class="border border-ink/30 px-2 py-0.5 text-ink/70">Beta {p.data.beta}</span>}
                </div>
              </div>
              <div class="col-span-12 lg:col-span-2 lg:text-right">
                <p class="font-mono text-[11px] uppercase tracking-widest text-ink-mute">{p.data.modelo}</p>
                <p class="mt-2 font-display text-xl text-ink">{p.data.precio_desde}</p>
                <p class="mt-2 font-mono text-xs text-ink/70 transition-colors group-hover:text-magenta">Leer el plan →</p>
              </div>
            </a>
          </li>
        ))}
      </ol>

      <p id="empty-msg" class="mt-12 hidden text-center font-display text-xl text-ink/75">
        No hay productos que coincidan con los filtros seleccionados.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-ink py-20 text-paper md:py-28">
    <div class="container-x">
      <div class="grid grid-cols-12 gap-x-8">
        <div class="col-span-12 lg:col-span-9 lg:col-start-2">
          <span class="label !text-paper/60">— Betas</span>
          <h2 class="mt-4 font-display text-display-md leading-tight text-paper md:text-display-lg">
            Si quieres probar uno <em class="italic text-magenta">antes que nadie</em>, dilo.
          </h2>
          <p class="mt-6 max-w-measure text-paper/80">
            Cada producto arranca con una beta de pocas organizaciones a mitad de precio, a cambio de opinión honesta. Si tu entidad encaja con alguno, Startidea te avisa cuando abra.
          </p>
          <div class="mt-12 flex flex-wrap gap-4">
            <a href="/contacto?asunto=beta-productos" class="btn !bg-paper !text-ink !border-paper hover:!bg-magenta hover:!text-paper hover:!border-magenta">
              Apuntarme a una beta
              <span aria-hidden="true">→</span>
            </a>
            <a href="/hub" class="btn-ghost !text-paper !border-paper hover:!bg-paper hover:!text-ink">
              Ver la plataforma
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .filter-pill {
    @apply border border-ink/30 px-3 py-1.5 text-ink/70 transition-colors hover:border-ink hover:text-ink;
  }
  .filter-pill.active {
    @apply border-ink bg-ink text-paper;
  }
</style>

<script is:inline>
  (function () {
    var state = { categoria: '', estado: '' };
    var items = document.querySelectorAll('.producto-item');
    var empty = document.getElementById('empty-msg');

    function applyFilter() {
      var visibles = 0;
      items.forEach(function (el) {
        var okCat = !state.categoria || el.dataset.categoria === state.categoria;
        var okEst = !state.estado || el.dataset.estado === state.estado;
        var ok = okCat && okEst;
        el.style.display = ok ? '' : 'none';
        if (ok) visibles++;
      });
      if (empty) empty.classList.toggle('hidden', visibles > 0);
    }

    document.querySelectorAll('.filter-pill').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var filter = btn.dataset.filter;
        var value = btn.dataset.value || '';
        state[filter] = value;
        document.querySelectorAll('.filter-pill[data-filter="' + filter + '"]').forEach(function (b) {
          b.classList.toggle('active', (b.dataset.value || '') === value);
        });
        applyFilter();
      });
    });
  })();
</script>
