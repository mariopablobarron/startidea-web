---
/**
 * /subvenciones/estudio-tercer-sector-2026
 *
 * Estudio con datos propios: radiografía de las convocatorias de subvención
 * abiertas a entidades sin ánimo de lucro en España.
 *
 * FUENTE — Base de Datos Nacional de Subvenciones (BDNS), ingestada por el
 * catálogo de Startidea (tabla Subsidy del HUB, source='bdns').
 * VENTANA — published_at (fechaRecepcion BDNS) entre 2026-03-01 y 2026-08-31.
 *   Anterior a marzo de 2026 la serie no tiene cobertura completa y queda fuera.
 *   Septiembre queda fuera por estar en curso.
 * DEFINICIÓN — "tercer sector" = convocatorias cuyo tipo de beneficiario BDNS
 *   incluye "PERSONAS JURÍDICAS QUE NO DESARROLLAN ACTIVIDAD ECONÓMICA".
 *   Las 3.857 del estudio cumplen exactamente ese criterio.
 * CIFRAS — todas calculadas el 2026-09-02. Si se reejecuta el análisis hay que
 *   actualizar TAMBIÉN la fecha del método, el n y el dateModified del Dataset.
 *   Nunca tocar una cifra suelta sin recalcular el resto: son internamente
 *   consistentes (porcentajes derivados de los mismos denominadores).
 */
import Base from '@/layouts/Base.astro';
import {
  breadcrumbList,
  datasetSchema,
  faqPageSchema,
  SITE_URL,
} from '@/lib/jsonld';

export const prerender = true;

const URL_PAGINA = `${SITE_URL}/subvenciones/estudio-tercer-sector-2026`;
const PUBLICADO = '2026-09-02';
const VENTANA_TXT = 'del 1 de marzo al 31 de agosto de 2026';
const N = '3.857';

/** Distribución por nivel administrativo del órgano convocante. */
const NIVELES = [
  {
    nivel: 'Local (ayuntamientos, diputaciones, cabildos)',
    n: '2.779',
    pct: '72,1 %',
    dinero: '788,4 M€',
    pctDinero: '8,6 %',
    mediana: '30.000 €',
  },
  {
    nivel: 'Autonómico',
    n: '904',
    pct: '23,4 %',
    dinero: '5.392,3 M€',
    pctDinero: '58,8 %',
    mediana: '450.000 €',
  },
  {
    nivel: 'Estatal',
    n: '174',
    pct: '4,5 %',
    dinero: '2.983,9 M€',
    pctDinero: '32,6 %',
    mediana: '619.305 €',
  },
];

/** Concentración del presupuesto. */
const CONCENTRACION = [
  { tramo: 'Las 10 convocatorias mayores', dinero: '5.547,0 M€', pct: '60,5 %' },
  { tramo: 'El 1 % mayor (39 convocatorias)', dinero: '6.622,3 M€', pct: '72,3 %' },
  { tramo: 'El 10 % mayor (386 convocatorias)', dinero: '8.590,2 M€', pct: '93,7 %' },
  { tramo: `El resto (${N} − 386 = 3.471 convocatorias)`, dinero: '574,4 M€', pct: '6,3 %' },
];

/** Distribución de plazos, sobre las 1.480 convocatorias con plazo analizable. */
const PLAZOS = [
  { tramo: '10 días o menos', n: '21', pct: '1,4 %' },
  { tramo: '15 días o menos', n: '57', pct: '3,9 %' },
  { tramo: '20 días o menos', n: '118', pct: '8,0 %' },
  { tramo: '30 días o menos', n: '386', pct: '26,1 %' },
  { tramo: '45 días o menos', n: '740', pct: '50,0 %' },
  { tramo: '60 días o menos', n: '883', pct: '59,7 %' },
];

/** Finalidad declarada. Solo las que superan el 2 % del total. */
const FINALIDADES = [
  { f: 'Cultura', n: '921', pct: '23,9 %', plazo: '39' },
  { f: 'Servicios sociales', n: '798', pct: '20,7 %', plazo: '107' },
  { f: 'Otras prestaciones económicas', n: '417', pct: '10,8 %', plazo: '46' },
  { f: 'Educación', n: '413', pct: '10,7 %', plazo: '44' },
  { f: 'Otras actuaciones de carácter económico', n: '341', pct: '8,8 %', plazo: '44' },
  { f: 'Fomento del empleo', n: '185', pct: '4,8 %', plazo: '48' },
  { f: 'Comercio y turismo', n: '143', pct: '3,7 %', plazo: '37,5' },
  { f: 'Agricultura y pesca', n: '121', pct: '3,1 %', plazo: '35' },
  { f: 'Cooperación internacional', n: '118', pct: '3,1 %', plazo: '42' },
  { f: 'I+D+i', n: '107', pct: '2,8 %', plazo: '35' },
  { f: 'Sanidad', n: '80', pct: '2,1 %', plazo: '—' },
  { f: 'Infraestructuras', n: '76', pct: '2,0 %', plazo: '36' },
];

/** Ritmo de publicación por mes. */
const MESES = [
  { mes: 'Marzo', n: '357', dias: '18', ritmo: '19,8' },
  { mes: 'Abril', n: '808', dias: '23', ritmo: '35,1' },
  { mes: 'Mayo', n: '661', dias: '24', ritmo: '27,5' },
  { mes: 'Junio', n: '920', dias: '25', ritmo: '36,8' },
  { mes: 'Julio', n: '706', dias: '25', ritmo: '28,2' },
  { mes: 'Agosto', n: '405', dias: '24', ritmo: '16,9' },
];

/** Convocatorias autonómicas por comunidad. */
const CCAA = [
  { c: 'Cataluña', n: '113' },
  { c: 'Andalucía', n: '91' },
  { c: 'Galicia', n: '89' },
  { c: 'Comunitat Valenciana', n: '73' },
  { c: 'Asturias', n: '73' },
  { c: 'Madrid', n: '72' },
  { c: 'Extremadura', n: '62' },
  { c: 'Navarra', n: '61' },
  { c: 'Illes Balears', n: '42' },
  { c: 'La Rioja', n: '38' },
  { c: 'Cantabria', n: '38' },
  { c: 'Canarias', n: '31' },
  { c: 'Murcia', n: '31' },
  { c: 'Castilla y León', n: '30' },
  { c: 'Castilla-La Mancha', n: '25' },
  { c: 'Aragón', n: '16' },
  { c: 'País Vasco', n: '12' },
  { c: 'Melilla', n: '5' },
  { c: 'Ceuta', n: '2' },
];

const FAQS = [
  {
    q: '¿Cuántas subvenciones hay para asociaciones y fundaciones en España?',
    a: 'Entre el 1 de marzo y el 31 de agosto de 2026 la Base de Datos Nacional de Subvenciones registró 3.857 convocatorias abiertas a personas jurídicas sin actividad económica, la categoría que agrupa a asociaciones, fundaciones y demás entidades no lucrativas. Son el 34,6 % de las 11.148 convocatorias publicadas en ese periodo y equivalen a 27,7 convocatorias nuevas por cada día con publicación en la BDNS.',
  },
  {
    q: '¿Cuánto plazo dan las subvenciones para presentar la solicitud?',
    a: 'La mediana es de 45,5 días naturales entre la fecha de registro en la BDNS y el cierre del plazo. Una de cada cuatro convocatorias (26,1 %) cierra en 30 días o menos, y el 3,9 % en 15 días o menos. El cálculo se hace sobre las 1.480 convocatorias con fecha de cierre coherente y verificable: el 57,5 % del total no publica fecha de fin de solicitud en la BDNS.',
  },
  {
    q: '¿De cuánto dinero son las subvenciones al tercer sector?',
    a: 'La mediana del presupuesto total declarado por convocatoria es de 57.000 €, con un cuartil inferior en 15.000 € y uno superior en 300.000 €. La media (2,4 M€) no describe nada útil porque el reparto está muy concentrado: el 1 % de las convocatorias acumula el 72,3 % del dinero. Conviene recordar que ese importe es el crédito total de la convocatoria, no la ayuda que recibe cada entidad.',
  },
  {
    q: '¿Qué administración convoca más subvenciones para entidades sociales?',
    a: 'La administración local. El 72,1 % de las convocatorias las publican ayuntamientos, diputaciones y cabildos, pero solo mueven el 8,6 % del presupuesto. Las autonómicas son el 23,4 % de las convocatorias y el 58,8 % del dinero; las estatales, el 4,5 % y el 32,6 %. En seis meses aparecieron 1.144 órganos convocantes distintos.',
  },
  {
    q: '¿En qué mes se publican más convocatorias?',
    a: 'Junio es el pico, con 36,8 convocatorias por día de publicación, seguido de abril (35,1). Agosto es el valle claro, con 16,9. Por cierres, diciembre (254), mayo (232), junio (226) y septiembre (216) concentran los finales de plazo, lo que sitúa los meses de más carga de tramitación en primavera y en el arranque del último trimestre.',
  },
  {
    q: '¿Se puede reutilizar y citar este estudio?',
    a: 'Sí. Los datos se publican bajo licencia Creative Commons BY 4.0: cualquier medio, entidad o investigador puede reproducir las cifras citando la fuente como «Startidea, Radiografía de las subvenciones al tercer sector 2026». La fuente primaria es pública y consultable en la Base de Datos Nacional de Subvenciones del Ministerio de Hacienda.',
  },
];

const jsonLd = [
  breadcrumbList([
    { name: 'Inicio', url: `${SITE_URL}/` },
    { name: 'Subvenciones', url: `${SITE_URL}/subvenciones` },
    { name: 'Estudio: tercer sector 2026', url: URL_PAGINA },
  ]),
  datasetSchema({
    url: URL_PAGINA,
    name: 'Radiografía de las subvenciones al tercer sector en España 2026',
    description:
      'Análisis de Startidea sobre las 3.857 convocatorias de subvención publicadas en la Base de Datos Nacional de Subvenciones entre el 1 de marzo y el 31 de agosto de 2026 que admiten a personas jurídicas sin actividad económica: distribución por nivel administrativo, comunidad autónoma, finalidad e importe, concentración del presupuesto, duración de los plazos de solicitud y estacionalidad.',
    datePublished: PUBLICADO,
    temporalCoverage: '2026-03-01/2026-08-31',
    spatialCoverage: 'España',
    keywords: [
      'subvenciones tercer sector',
      'BDNS',
      'convocatorias ONG',
      'asociaciones',
      'fundaciones',
      'financiación pública',
      'plazos de solicitud',
    ],
    isBasedOn: {
      name: 'Base de Datos Nacional de Subvenciones (BDNS)',
      url: 'https://www.infosubvenciones.es/bdnstrans/GE/es/convocatorias',
    },
  }),
  faqPageSchema(FAQS),
];
---

<Base
  title="Subvenciones al tercer sector 2026: estudio · Startidea"
  description="Estudio sobre 3.857 convocatorias BDNS abiertas al tercer sector (mar-ago 2026): el 1% concentra el 72% del dinero y una de cada cuatro cierra en 30 días."
  ogSlug="page/subvenciones"
  ogType="article"
  ogImageAlt="Radiografía de las subvenciones al tercer sector en España 2026 — estudio de Startidea"
  article={{
    publishedTime: `${PUBLICADO}T00:00:00Z`,
    modifiedTime: `${PUBLICADO}T00:00:00Z`,
    author: 'Startidea',
    section: 'Subvenciones',
    tags: ['subvenciones', 'tercer sector', 'BDNS', 'financiación pública'],
  }}
  jsonLd={jsonLd}
>

  <!-- Migas visibles -->
  <nav aria-label="Migas de pan" class="border-b border-ink/15 bg-paper py-3">
    <div class="container-x">
      <ol class="flex flex-wrap items-center gap-2 font-mono text-[10px] uppercase tracking-widest text-ink/60">
        <li><a href="/" class="hover:text-ink">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/subvenciones" class="hover:text-ink">Subvenciones</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">Estudio 2026</li>
      </ol>
    </div>
  </nav>

  <!-- Hero -->
  <section class="bg-ink py-16 text-paper md:py-24">
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        <span class="font-mono text-[11px] uppercase tracking-widest text-magenta">
          — Estudio con datos propios · publicado el 2 de septiembre de 2026
        </span>
        <h1 class="mt-4 font-display text-display-xl leading-[1.02] text-paper">
          Radiografía de las subvenciones al<br />
          <em class="italic text-magenta">tercer sector</em> en España.
        </h1>
        <p class="mt-6 text-lede text-paper/80">
          Startidea ha analizado las <strong class="text-paper">{N} convocatorias</strong>
          publicadas en la Base de Datos Nacional de Subvenciones {VENTANA_TXT}
          que admiten a entidades sin ánimo de lucro. Esto es lo que dicen los
          datos sobre cuánto dinero hay, dónde está y cuánto tiempo se da para
          pedirlo.
        </p>
        <p class="mt-3 text-base text-paper/65">
          Las cifras son públicas y verificables. El método está al final de la
          página, con sus límites declarados.
        </p>
      </div>
    </div>
  </section>

  <!-- Resumen extractable -->
  <section class="border-b border-ink/15 bg-paper-warm py-12 md:py-16">
    <div class="container-x">
      <div class="mx-auto max-w-3xl border-l-4 border-magenta bg-paper p-6 md:p-8">
        <p class="font-mono text-[10px] uppercase tracking-widest text-magenta">
          — En corto
        </p>
        <p class="mt-3 text-lg leading-relaxed text-ink">
          Hay muchísimas convocatorias y muy poco tiempo para responderlas. En
          seis meses se publicaron {N} convocatorias abiertas al tercer sector
          —27,7 por cada día con publicación— repartidas entre 1.144 órganos
          distintos. El dinero, en cambio, casi no se reparte: el 1 % de las
          convocatorias concentra el 72,3 % del presupuesto. Y una de cada
          cuatro cierra en 30 días o menos, cuando el 57,5 % ni siquiera publica
          fecha de cierre en la BDNS.
        </p>
      </div>
    </div>
  </section>

  <!-- Hallazgos -->
  <section id="hallazgos" class="border-b border-ink/15 bg-paper py-14 md:py-20">
    <div class="container-x">
      <div class="mx-auto max-w-4xl">
        <span class="font-mono text-[10px] uppercase tracking-widest text-ink/75">— Cinco hallazgos</span>
        <h2 class="mt-3 font-display text-display-md leading-tight text-ink">
          Lo que no se ve mirando una convocatoria de una en una.
        </h2>

        <div class="mt-10 space-y-6">
          <div class="border border-ink/15 bg-paper-warm p-6 md:p-8">
            <p class="font-display text-4xl leading-none text-magenta md:text-5xl">72,3 %</p>
            <h3 class="mt-3 font-display text-xl text-ink">
              El 1 % de las convocatorias concentra casi tres cuartas partes del dinero.
            </h3>
            <p class="mt-2 max-w-measure leading-relaxed text-ink/80">
              Las 39 convocatorias mayores acumulan 6.622,3 M€ de los 9.164,6 M€
              declarados en total. Solo dos órganos —la Agencia de la Vivienda de
              Cataluña y la Dirección General de Cooperación Autonómica y Local—
              suman entre seis convocatorias 4.827,7 M€, el 52,7 % de todo el
              presupuesto del periodo. Cualquier cifra agregada de «dinero
              disponible para el tercer sector» que no explique esto está mal
              contada.
            </p>
          </div>

          <div class="border border-ink/15 bg-paper-warm p-6 md:p-8">
            <p class="font-display text-4xl leading-none text-magenta md:text-5xl">26,1 %</p>
            <h3 class="mt-3 font-display text-xl text-ink">
              Una de cada cuatro convocatorias cierra en 30 días o menos.
            </h3>
            <p class="mt-2 max-w-measure leading-relaxed text-ink/80">
              La mediana del plazo es de 45,5 días naturales entre registro y
              cierre. El 8,0 % da 20 días o menos y el 3,9 %, quince o menos.
              Para una entidad pequeña, que además tiene que reunir certificados
              de estar al corriente, memoria y presupuesto, ese margen no da para
              formular un proyecto: da para copiar el del año pasado.
            </p>
          </div>

          <div class="border border-ink/15 bg-paper-warm p-6 md:p-8">
            <p class="font-display text-4xl leading-none text-magenta md:text-5xl">57,5 %</p>
            <h3 class="mt-3 font-display text-xl text-ink">
              Más de la mitad de las convocatorias no publica fecha de cierre en la BDNS.
            </h3>
            <p class="mt-2 max-w-measure leading-relaxed text-ink/80">
              2.219 de las {N} no traen fecha de fin de solicitud en el registro
              nacional. El plazo real existe, pero vive dentro del PDF de bases o
              del boletín correspondiente. Es la razón por la que vigilar
              subvenciones a mano no escala: no basta con mirar una lista, hay
              que abrir cada expediente.
            </p>
          </div>

          <div class="border border-ink/15 bg-paper-warm p-6 md:p-8">
            <p class="font-display text-4xl leading-none text-magenta md:text-5xl">72,1 % / 8,6 %</p>
            <h3 class="mt-3 font-display text-xl text-ink">
              Casi tres de cada cuatro convocatorias son locales, y mueven menos del 9 % del dinero.
            </h3>
            <p class="mt-2 max-w-measure leading-relaxed text-ink/80">
              El grueso del volumen lo generan ayuntamientos, diputaciones y
              cabildos: 2.779 convocatorias con una mediana de 30.000 €. El dinero
              está arriba: las 904 autonómicas y las 174 estatales suman el 91,4 %
              del presupuesto. Una entidad que solo mire su ayuntamiento ve el
              72 % de las oportunidades y menos del 9 % de la financiación.
            </p>
          </div>

          <div class="border border-ink/15 bg-paper-warm p-6 md:p-8">
            <p class="font-display text-4xl leading-none text-magenta md:text-5xl">921 vs 798</p>
            <h3 class="mt-3 font-display text-xl text-ink">
              Cultura convoca más que servicios sociales, pero da la mitad de plazo.
            </h3>
            <p class="mt-2 max-w-measure leading-relaxed text-ink/80">
              Cultura es la finalidad más frecuente (921 convocatorias, 23,9 %) por
              delante de servicios sociales (798, 20,7 %). La diferencia está en el
              tiempo: la mediana de plazo en servicios sociales es de 107 días y en
              cultura, de 39. Las convocatorias culturales son más, más pequeñas y
              mucho más rápidas de cerrar.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Quién convoca -->
  <section id="quien-convoca" class="border-b border-ink/15 bg-paper-warm py-14 md:py-20">
    <div class="container-x">
      <div class="mx-auto max-w-4xl">
        <span class="font-mono text-[10px] uppercase tracking-widest text-ink/75">— Quién convoca</span>
        <h2 class="mt-3 font-display text-display-md leading-tight text-ink">
          Muchas puertas pequeñas, pocas puertas grandes.
        </h2>
        <p class="mt-4 max-w-measure leading-relaxed text-ink/80">
          En seis meses aparecen <strong>1.144 órganos convocantes distintos</strong>:
          1.961 convocatorias las firman ayuntamientos y 634, diputaciones,
          cabildos y consells insulars. Ninguno concentra más del 2,2 % del total.
        </p>

        <div class="mt-8 overflow-x-auto">
          <table class="w-full min-w-[42rem] border-collapse text-sm">
            <caption class="sr-only">
              Convocatorias abiertas al tercer sector por nivel administrativo del
              órgano convocante, marzo-agosto de 2026
            </caption>
            <thead>
              <tr class="border-b-2 border-ink/25 text-left">
                <th scope="col" class="py-3 pr-4 font-mono text-[10px] uppercase tracking-widest text-ink/75">Nivel</th>
                <th scope="col" class="py-3 pr-4 text-right font-mono text-[10px] uppercase tracking-widest text-ink/75">Convocatorias</th>
                <th scope="col" class="py-3 pr-4 text-right font-mono text-[10px] uppercase tracking-widest text-ink/75">% del total</th>
                <th scope="col" class="py-3 pr-4 text-right font-mono text-[10px] uppercase tracking-widest text-ink/75">Presupuesto</th>
                <th scope="col" class="py-3 pr-4 text-right font-mono text-[10px] uppercase tracking-widest text-ink/75">% del dinero</th>
                <th scope="col" class="py-3 text-right font-mono text-[10px] uppercase tracking-widest text-ink/75">Importe mediano</th>
              </tr>
            </thead>
            <tbody>
              {NIVELES.map((r) => (
                <tr class="border-b border-ink/15">
                  <th scope="row" class="py-3 pr-4 text-left font-normal text-ink">{r.nivel}</th>
                  <td class="py-3 pr-4 text-right tabular-nums text-ink">{r.n}</td>
                  <td class="py-3 pr-4 text-right tabular-nums text-ink/75">{r.pct}</td>
                  <td class="py-3 pr-4 text-right tabular-nums text-ink">{r.dinero}</td>
                  <td class="py-3 pr-4 text-right tabular-nums text-ink/75">{r.pctDinero}</td>
                  <td class="py-3 text-right tabular-nums text-ink">{r.mediana}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="mt-3 font-mono text-[10px] uppercase tracking-widest text-ink/60">
          Fuente: análisis de Startidea sobre {N} convocatorias de la BDNS, {VENTANA_TXT}
        </p>
      </div>
    </div>
  </section>

  <!-- Dinero -->
  <section id="dinero" class="border-b border-ink/15 bg-paper py-14 md:py-20">
    <div class="container-x">
      <div class="mx-auto max-w-4xl">
        <span class="font-mono text-[10px] uppercase tracking-widest text-ink/75">— Cuánto dinero</span>
        <h2 class="mt-3 font-display text-display-md leading-tight text-ink">
          La media miente. La mediana son 57.000 €.
        </h2>
        <p class="mt-4 max-w-measure leading-relaxed text-ink/80">
          El presupuesto total declarado por las {N} convocatorias suma
          9.164,6 M€, pero la media aritmética (2,4 M€ por convocatoria) no
          describe ninguna convocatoria real. La distribución honesta es la de
          los cuartiles: el 25 % inferior no llega a 15.000 € y el 25 % superior
          supera los 300.000 €. Y 628 convocatorias —el 16,3 %— tienen un
          presupuesto total inferior a 10.000 €.
        </p>

        <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-4">
          <div class="border border-ink/15 bg-paper-warm p-5">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink/75">Cuartil inferior</p>
            <p class="mt-1 font-display text-2xl text-ink">15.000 €</p>
          </div>
          <div class="border-2 border-magenta bg-magenta/5 p-5">
            <p class="font-mono text-[10px] uppercase tracking-widest text-magenta">Mediana</p>
            <p class="mt-1 font-display text-2xl text-magenta">57.000 €</p>
          </div>
          <div class="border border-ink/15 bg-paper-warm p-5">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink/75">Cuartil superior</p>
            <p class="mt-1 font-display text-2xl text-ink">300.000 €</p>
          </div>
          <div class="border border-ink/15 bg-paper-warm p-5">
            <p class="font-mono text-[10px] uppercase tracking-widest text-ink/75">Suma declarada</p>
            <p class="mt-1 font-display text-2xl text-ink">9.164,6 M€</p>
          </div>
        </div>

        <h3 class="mt-12 font-display text-xl text-ink">Cómo se concentra el presupuesto</h3>
