---
import Base from '@/layouts/Base.astro';
import { breadcrumbList, SITE_URL } from '@/lib/jsonld';

const jsonLd = breadcrumbList([
  { name: 'Inicio', url: `${SITE_URL}/` },
  { name: 'Laboratorio', url: `${SITE_URL}/laboratorio` },
  { name: 'IA para el bien común', url: `${SITE_URL}/laboratorio/ia` },
  { name: 'Plantilla de control económico para restaurantes', url: `${SITE_URL}/recursos/plantilla-control-restaurante` },
]);
---

<Base
  title="Plantilla Excel de control económico para restaurantes — Startidea"
  description="Excel gratuito con 9 hojas conectadas: ventas, escandallos, ingeniería de menú, personal, gastos, deuda y dashboard con punto de equilibrio. Descubre dónde gana y dónde pierde dinero tu restaurante."
  ogSlug="page/recursos-restaurante"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="border-b border-ink/15 bg-paper py-16 md:py-24 lg:py-28">
    <div class="container-x">
      <p class="font-mono text-[11px] uppercase tracking-widest text-ink-mute">
        <a href="/laboratorio/ia" class="link-underline text-ink/70 hover:text-ink">← IA para el bien común</a>
      </p>
      <span class="label mt-6 block">— Recurso descargable · Gratis</span>

      <div class="mt-6 grid grid-cols-12 gap-x-8 gap-y-12">
        <div class="col-span-12 lg:col-span-7">
          <h1 class="font-display text-display-xl leading-[0.96] text-ink">
            ¿Dónde gana dinero<br/>
            <em class="italic text-magenta">tu restaurante</em>?<br/>
            ¿Y dónde lo pierde?
          </h1>
          <p class="mt-8 max-w-measure text-lede text-ink/80">
            Excel profesional con <strong>9 hojas conectadas y fórmulas automáticas</strong>: se rellenan las ventas, la carta, los costes y las deudas, y el dashboard responde solo — cuánto se gana de verdad, cuánto hay que facturar para no perder dinero y qué platos dejan margen y cuáles lo comen.
          </p>

          <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-3 max-w-md font-mono text-[11px] uppercase tracking-widest text-ink/70">
            <li>▸ Dashboard automático</li>
            <li>▸ Punto de equilibrio</li>
            <li>▸ Food cost y prime cost</li>
            <li>▸ Ingeniería de menú</li>
            <li>▸ Escandallos con mermas</li>
            <li>▸ Margen por bebida</li>
            <li>▸ Coste de personal</li>
            <li>▸ Deuda y cuotas</li>
            <li>▸ Simulador «¿y si…?»</li>
            <li>▸ Con datos de ejemplo</li>
          </ul>
        </div>

        <!-- Form -->
        <aside class="col-span-12 lg:col-span-5 lg:col-start-8">
          <div class="border-2 border-ink bg-paper-warm p-7">
            <p class="label">— Recibir la plantilla</p>
            <h2 class="mt-3 font-display text-2xl leading-tight text-ink md:text-3xl">
              <em class="italic text-magenta">Gratis</em>. Sin letra pequeña.
            </h2>

            <form id="lead-form" class="mt-6 space-y-3" novalidate>
              <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

              <div>
                <label class="sr-only" for="lead-name">Tu nombre</label>
                <input id="lead-name" name="name" type="text" required maxlength="80" autocomplete="name" placeholder="Tu nombre"
                  class="w-full border border-ink bg-paper px-4 py-3 font-mono text-sm text-ink placeholder:text-ink/75 focus:border-magenta focus:outline-none focus:ring-2 focus:ring-magenta/40" />
              </div>
              <div>
                <label class="sr-only" for="lead-email">Email</label>
                <input id="lead-email" name="email" type="email" required maxlength="120" autocomplete="email" placeholder="tu@email.com"
                  class="w-full border border-ink bg-paper px-4 py-3 font-mono text-sm text-ink placeholder:text-ink/75 focus:border-magenta focus:outline-none focus:ring-2 focus:ring-magenta/40" />
              </div>
              <div>
                <label class="sr-only" for="lead-org">Restaurante o negocio</label>
                <input id="lead-org" name="organization" type="text" maxlength="120" placeholder="Tu restaurante o negocio (opcional)"
                  class="w-full border border-ink bg-paper px-4 py-3 font-mono text-sm text-ink placeholder:text-ink/75 focus:border-magenta focus:outline-none focus:ring-2 focus:ring-magenta/40" />
              </div>

              <label class="flex items-start gap-3 py-2 text-sm text-ink/85 cursor-pointer">
                <input type="checkbox" name="newsletter" class="mt-1 h-4 w-4 cursor-pointer accent-magenta" checked />
                <span>Suscribirme también a la nota mensual de Startidea (cero ruido, baja cuando quieras)</span>
              </label>

              <button type="submit" id="lead-submit" class="btn w-full justify-center !py-3">
                Descargar el Excel
                <span aria-hidden="true">↓</span>
              </button>

              <p id="lead-status" class="min-h-[20px] font-mono text-[11px] leading-relaxed text-ink-mute" aria-live="polite"></p>

              <p class="border-t border-ink/15 pt-3 font-mono text-[10px] uppercase tracking-widest text-ink-mute">
                Sin tracking pixels · Sin spam · RGPD
              </p>
            </form>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Qué contiene -->
  <section class="bg-paper-warm py-20 md:py-28">
    <div class="container-x">
      <div class="grid grid-cols-12 gap-x-8 border-t border-ink/15 pt-8">
        <div class="col-span-12 lg:col-span-3">
          <span class="label">— Lo que responde</span>
        </div>
        <div class="col-span-12 mt-6 lg:col-span-9 lg:mt-0">
          <ol class="divide-y divide-ink/15 border-y border-ink/15">
            <li class="grid grid-cols-12 gap-x-6 py-6">
              <span class="num-edit col-span-2 text-3xl">01</span>
              <div class="col-span-10">
                <h3 class="font-display text-lg leading-tight text-ink md:text-xl">¿Cuánto gano realmente?</h3>
                <p class="mt-1 text-sm text-ink/75">Resultado operativo y resultado tras cuotas de deuda: la caja que queda de verdad cada mes, no la sensación.</p>
              </div>
            </li>
            <li class="grid grid-cols-12 gap-x-6 py-6">
              <span class="num-edit col-span-2 text-3xl">02</span>
              <div class="col-span-10">
                <h3 class="font-display text-lg leading-tight text-ink md:text-xl">¿Cuánto tengo que facturar para no perder dinero?</h3>
                <p class="mt-1 text-sm text-ink/75">Punto de equilibrio mensual calculado con los costes fijos y el margen de contribución reales del negocio.</p>
              </div>
            </li>
            <li class="grid grid-cols-12 gap-x-6 py-6">
              <span class="num-edit col-span-2 text-3xl">03</span>
              <div class="col-span-10">
                <h3 class="font-display text-lg leading-tight text-ink md:text-xl">¿Qué platos me dejan dinero y cuáles me lo quitan?</h3>
                <p class="mt-1 text-sm text-ink/75">Ingeniería de menú automática: cada plato clasificado por popularidad y margen — cuál mantener, cuál promocionar, cuál subir de precio y cuál retirar.</p>
              </div>
            </li>
            <li class="grid grid-cols-12 gap-x-6 py-6">
              <span class="num-edit col-span-2 text-3xl">04</span>
              <div class="col-span-10">
                <h3 class="font-display text-lg leading-tight text-ink md:text-xl">¿Están mis costes donde deben?</h3>
                <p class="mt-1 text-sm text-ink/75">Food cost, coste de bebidas, coste laboral y prime cost, cada uno con su objetivo de referencia del sector al lado.</p>
              </div>
            </li>
            <li class="grid grid-cols-12 gap-x-6 py-6">
              <span class="num-edit col-span-2 text-3xl">05</span>
              <div class="col-span-10">
                <h3 class="font-display text-lg leading-tight text-ink md:text-xl">¿Qué pasa si…?</h3>
                <p class="mt-1 text-sm text-ink/75">Simulador de decisiones: subir precios un 5%, aumentar el ticket medio 2 €, comprar un 8% más barato — cada palanca con su impacto en euros al mes.</p>
              </div>
            </li>
            <li class="grid grid-cols-12 gap-x-6 py-6">
              <span class="num-edit col-span-2 text-3xl">06</span>
              <div class="col-span-10">
                <h3 class="font-display text-lg leading-tight text-ink md:text-xl">¿Puedo asumir mis deudas?</h3>
                <p class="mt-1 text-sm text-ink/75">Endeudamiento total, cuota mensual y qué porcentaje de las ventas se va en pagar préstamos.</p>
              </div>
            </li>
          </ol>
          <p class="mt-6 text-sm text-ink/70">
            Viene rellena con un restaurante de ejemplo completo para ver cómo funciona; se sustituyen los datos de ejemplo por los reales y todo se recalcula solo. Incluye hoja de instrucciones con la lista de datos que hay que recopilar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA consultoría -->
  <section class="bg-ink py-20 text-paper md:py-28">
    <div class="container-x">
      <div class="grid grid-cols-12 gap-x-8">
        <div class="col-span-12 lg:col-span-9 lg:col-start-2">
          <span class="label !text-paper/60">— Después de los números</span>
          <h2 class="mt-4 font-display text-display-lg leading-[0.98] text-paper">
            Los números dicen dónde está<br/>
            <em class="italic text-magenta">la oportunidad</em>. Capturarla es otra cosa.
          </h2>
          <p class="mt-6 max-w-measure text-lede text-paper/80">
            Si la plantilla destapa martes vacíos, platos populares sin margen o un ticket medio corto, ese es exactamente el trabajo de Startidea: estrategia local de captación, Google Business, campañas y reputación — a partir de tus datos, no de recetas genéricas.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href="/diagnostico" class="btn">Quiero que Startidea estudie mi negocio →</a>
            <a href="/contacto" class="btn-ghost !border-paper/40 !text-paper hover:!bg-paper/10">Reservar llamada de 30 min</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script is:inline>
  (function () {
    var form = document.getElementById('lead-form');
    var status = document.getElementById('lead-status');
    var submit = document.getElementById('lead-submit');
    if (!form) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var data = new FormData(form);
      // Honeypot
      if ((data.get('website') || '').toString().trim() !== '') {
        // Bot — fingimos éxito
        window.location.href = '/recursos/gracias?slug=plantilla-control-restaurante';
        return;
      }

      submit.setAttribute('disabled', 'true');
      status.style.color = '';
      status.textContent = 'Enviando…';

      var payload = {
        name: (data.get('name') || '').toString().trim(),
        email: (data.get('email') || '').toString().trim(),
        organization: (data.get('organization') || '').toString().trim(),
        newsletter: data.get('newsletter') === 'on',
        slug: 'plantilla-control-restaurante',
      };

      try {
        var r = await fetch('/api/recursos/solicitar', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var json = await r.json().catch(function () { return { ok: false }; });
        if (r.ok && json.ok) {
          window.stTrack && window.stTrack('generate_lead', {
            method: 'lead_magnet',
            file_name: 'plantilla-control-restaurante.xlsx',
            page_path: '/recursos/plantilla-control-restaurante',
          });
          window.location.href = '/recursos/gracias?slug=plantilla-control-restaurante';
        } else {
          status.style.color = '#b42318';
          status.textContent = json.error === 'rate'
            ? 'Espera unos segundos antes de reintentar.'
            : 'No se pudo enviar. Escríbenos a hola@startidea.es.';
          submit.removeAttribute('disabled');
        }
      } catch (_) {
        status.style.color = '#b42318';
        status.textContent = 'Sin conexión. Escríbenos a hola@startidea.es.';
        submit.removeAttribute('disabled');
      }
    });
  })();
</script>
