---
import Base from '@/layouts/Base.astro';
import { breadcrumbList, jobPostingSchema, SITE_URL } from '@/lib/jsonld';

const OFERTA_URL = `${SITE_URL}/empleo/direccion-campanas-alianzas`;

const jsonLd = [
  breadcrumbList([
    { name: 'Inicio', url: `${SITE_URL}/` },
    { name: 'Trabaja con Startidea', url: `${SITE_URL}/empleo` },
    { name: 'Dirección de campañas y alianzas', url: OFERTA_URL },
  ]),
  jobPostingSchema({
    url: OFERTA_URL,
    title: 'Dirección de campañas y alianzas',
    description:
      'Startidea, agencia de innovación social y comunicación en Granada, busca una voz con trayectoria pública en comunicación, periodismo o incidencia social para dirigir campañas y articular alianzas. La persona seleccionada diseñará y presentará propuestas de campañas con causa ante clientes del tercer sector, instituciones y empresas con propósito, y abrirá relaciones con organizaciones, medios e instituciones donde su nombre y su red aporten credibilidad. Formato flexible: colaboración por proyectos o dedicación parcial, compatible con actividad propia (conferencias, publicaciones, docencia). Trabajo en remoto con encuentros presenciales puntuales en Granada o Madrid. Condiciones a convenir según formato y dedicación.',
    datePosted: '2026-09-01',
    validThrough: '2026-11-30',
    employmentType: 'CONTRACTOR',
    telecommute: true,
    skills: [
      'Dirección de campañas de comunicación',
      'Comunicación con causa',
      'Relaciones institucionales y alianzas',
      'Portavocía y presentaciones',
      'Narrativa y storytelling',
      'Tercer sector',
    ],
  }),
];

const responsabilidades = [
  {
    bloque: 'Campañas',
    items: [
      'Diseñar propuestas de campañas de comunicación con causa: concepto, narrativa, canales y piezas.',
      'Presentarlas y defenderlas ante el cliente, con el respaldo del equipo de producción de Startidea.',
      'Dirigir creativamente las campañas ganadas: la ejecución la lleva el equipo, la voz y el criterio los pone esta persona.',
      'Aportar mirada propia sobre diversidad, derechos e inclusión a los proyectos de la agencia.',
    ],
  },
  {
    bloque: 'Alianzas',
    items: [
      'Articular relaciones con organizaciones del tercer sector, medios, fundaciones e instituciones.',
      'Abrir puertas donde una llamada suya vale más que diez correos: su red es parte del trabajo.',
      'Representar a Startidea en actos, jornadas y espacios sectoriales cuando tenga sentido.',
      'Detectar oportunidades de colaboración y traerlas a la mesa para convertirlas en proyectos.',
    ],
  },
];

const requisitos = [
  'Trayectoria pública demostrable en comunicación, periodismo, activismo o incidencia social.',
  'Red real y viva en el tercer sector, los medios o las instituciones. Se nota en la primera conversación.',
  'Capacidad de construir una narrativa y contarla bien, por escrito y delante de una sala.',
  'Criterio para decir qué campaña no hay que hacer. Se busca dirección, no ejecución.',
  'No hace falta experiencia en gestión de proyectos ni presupuestos: de eso se ocupa otra persona.',
];

const ofrece = [
  'Formato flexible: colaboración por proyectos o dedicación parcial, compatible con tu actividad propia (conferencias, publicaciones, docencia).',
  'Trabajo en remoto, con encuentros presenciales puntuales en Granada o Madrid.',
  'Libertad creativa real: campañas con causa donde la voz propia es el valor, no un riesgo.',
  'Condiciones a convenir según formato y dedicación; se hablan abiertamente desde el primer contacto.',
];
---

<Base
  title="Oferta: dirección de campañas y alianzas — Startidea"
  description="Startidea busca una voz con trayectoria pública en comunicación o incidencia social para dirigir campañas con causa y articular alianzas. Colaboración por proyectos o dedicación parcial, en remoto."
  ogSlug="page/empleo"
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="border-b border-ink/15 bg-paper py-16 md:py-24">
    <div class="container-x">
      <a href="/empleo" class="label hover:text-magenta">— Trabaja con Startidea</a>
      <h1 class="mt-4 max-w-4xl font-display text-display-xl leading-[0.96] text-ink">
        Dirección de campañas<br/><em class="italic text-magenta">y alianzas</em>.
      </h1>
      <div class="mt-6 flex flex-wrap gap-2 text-sm">
        <span class="border border-ink/20 bg-paper px-3 py-1 text-ink/80">Por proyectos o parcial</span>
        <span class="border border-ink/20 bg-paper px-3 py-1 text-ink/80">Remoto · Granada / Madrid</span>
        <span class="border border-ink/20 bg-paper px-3 py-1 text-ink/80">Compatible con actividad propia</span>
      </div>
      <p class="mt-8 max-w-measure text-lede text-ink/80">
        Startidea produce comunicación, audiovisual y tecnología para organizaciones con propósito. Lo que le falta no es capacidad de producir: es una voz reconocible que dirija las campañas, las presente y teja las alianzas que las hacen posibles. Esta oferta busca a alguien con trayectoria pública propia que quiera poner su criterio y su red al servicio de proyectos con causa, sin renunciar a lo suyo.
      </p>
    </div>
  </section>

  <!-- Detalle -->
  <section class="bg-paper-warm py-16 md:py-20">
    <div class="container-x space-y-14">
      {responsabilidades.map((r) => (
        <div class="grid grid-cols-12 gap-x-8 border-t border-ink/15 pt-8">
          <div class="col-span-12 lg:col-span-3">
            <span class="label">— {r.bloque}</span>
          </div>
          <ul class="col-span-12 mt-4 space-y-3 lg:col-span-9 lg:mt-0">
            {r.items.map((item) => (
              <li class="flex gap-3 text-ink/80">
                <span aria-hidden="true" class="text-magenta">→</span>
                <span class="max-w-measure">{item}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <div class="grid grid-cols-12 gap-x-8 border-t border-ink/15 pt-8">
        <div class="col-span-12 lg:col-span-3">
          <span class="label">— Qué se busca</span>
        </div>
        <ul class="col-span-12 mt-4 space-y-3 lg:col-span-9 lg:mt-0">
          {requisitos.map((item) => (
            <li class="flex gap-3 text-ink/80">
              <span aria-hidden="true" class="text-magenta">→</span>
              <span class="max-w-measure">{item}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="grid grid-cols-12 gap-x-8 border-t border-ink/15 pt-8">
        <div class="col-span-12 lg:col-span-3">
          <span class="label">— Qué se ofrece</span>
        </div>
        <ul class="col-span-12 mt-4 space-y-3 lg:col-span-9 lg:mt-0">
          {ofrece.map((item) => (
            <li class="flex gap-3 text-ink/80">
              <span aria-hidden="true" class="text-magenta">→</span>
              <span class="max-w-measure">{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="border-t border-ink/15 bg-paper py-16">
    <div class="container-x">
      <h2 class="max-w-3xl font-display text-3xl text-ink md:text-4xl">¿Hablamos?</h2>
      <p class="mt-4 max-w-measure text-ink/80">
        Si te reconoces en esta descripción, no hace falta CV formal: envía el formulario de la
        página de empleo con el área «Comunicación», enlaza tu trabajo público y cuenta qué
        campaña te gustaría firmar. También vale escribir directamente a
        <a href="mailto:hola@startidea.es" class="underline decoration-magenta/40 underline-offset-2">hola@startidea.es</a>.
      </p>
      <a href="/empleo#cand-form" class="btn mt-8 inline-flex">
        Iniciar la conversación <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Base>
