---
// /diagnostico — Diagnóstico adaptativo (página principal).
//
// Antes había una landing intermedia en /diagnostico que mandaba a
// /diagnostico/nuevo. Se eliminó ese paso: el formulario vive directamente aquí
// y /diagnostico/nuevo redirige a esta URL (compatibilidad de enlaces antiguos).
//
// Rediseño 2026-08-22 (dato: 81 sesiones tocaron el embudo en 8 semanas, 0
// envíos). El paso 1 dejó de ser el árbol SVG generado por JS: las 4 ramas y
// sus subtipos se renderizan ahora server-side como tarjetas visibles de un
// vistazo (rastreables por Google, legibles en móvil). Elegir un subtipo fija
// dos <input hidden> (audience, subType) y avanza el wizard. El contacto pasó
// del paso 2 al paso FINAL: primero se pide implicación barata (qué necesitas,
// tu reto), y el email solo al cierre.
//
// Orden de pasos: perfil → servicios → reto → recursos → contacto (+envío).
//
// Backend: POST a /api/diagnosticos/intake del HUB con kind="diagnostico"
// + answers JSON con campos extra (mission, fundingSources, legalStatus, ASE…).

import Base from "@/layouts/Base.astro";
import { breadcrumbList, localBusinessSchema, SITE_URL } from "@/lib/jsonld";
import { gruposPublicos } from "@/data/servicios";

// Catálogo COMPLETO de servicios sin precios (seguro para el cliente). El
// cliente marca lo que le interesa; el HUB/equipo hace el lookup de precios
// server-side para preparar el presupuesto + hoja de ruta que se envían luego.
const GRUPOS = gruposPublicos();

const jsonLd = [
  breadcrumbList([
    { name: "Inicio", url: `${SITE_URL}/` },
    { name: "Diagnóstico", url: `${SITE_URL}/diagnostico` },
  ]),
  localBusinessSchema(),
];

const INTAKE_URL = "https://hub.startidea.tech/api/diagnosticos/intake";

// Ramas del perfil, renderizadas server-side (visibles de un vistazo y
// rastreables). Elegir un subtipo fija audience+subType y avanza el wizard.
const AUDIENCES = [
  {
    id: "empresa",
    label: "Empresa",
    desc: "Vendes productos o servicios y quieres crecer con propósito.",
    subs: [
      { id: "pyme", label: "PYME" },
      { id: "gran-empresa", label: "Gran empresa" },
      { id: "startup", label: "Startup" },
      { id: "autonomo", label: "Autónomo/a" },
    ],
  },
  {
    id: "institucion",
    label: "Institución",
    desc: "Organización pública, eclesial, educativa o sanitaria.",
    subs: [
      { id: "eclesial", label: "Eclesial" },
      { id: "publica", label: "Pública" },
      { id: "educativa", label: "Educativa" },
      { id: "sanitaria", label: "Sanitaria" },
    ],
  },
  {
    id: "entidad-social",
    label: "Entidad social",
    desc: "Tercer sector: la misión es la causa, no el beneficio.",
    subs: [
      { id: "asociacion", label: "Asociación" },
      { id: "fundacion", label: "Fundación" },
      { id: "cooperativa-social", label: "Cooperativa social" },
      { id: "ong", label: "ONG" },
      { id: "red", label: "Red / Federación" },
    ],
  },
  {
    id: "emprendedor",
    label: "Emprendedor/a",
    desc: "Un proyecto en marcha o en la cabeza, con o sin nombre aún.",
    subs: [
      { id: "idea", label: "Idea" },
      { id: "mvp", label: "MVP" },
      { id: "validacion", label: "Validación" },
      { id: "escalado", label: "Escalando" },
    ],
  },
];

const STEP_NAMES = ["Perfil", "Necesidades", "Reto", "Recursos", "Contacto"];

---

<Base
  title="Diagnóstico de proyecto — Startidea · Granada"
  description="Cuéntale a Startidea tu reto en 3 minutos: eliges rama y solo respondes lo que aplica a tu caso. Recibes un briefing y una hoja de ruta antes de hablar."
  ogSlug="page/diagnostico"
  jsonLd={jsonLd}
>
  <section class="border-b border-ink/15 bg-paper py-12 md:py-16">
    <div class="container-x">
      <span class="label">
        — Diagnóstico · paso <span data-step-label>1</span> de 5
      </span>
      <h1 class="mt-4 font-display text-display-lg leading-[0.98] text-ink">
        Elige tu <em class="italic text-magenta">rama</em>.
      </h1>
      <p class="mt-6 max-w-measure text-ink/80">
        La raíz es quién eres; de ahí crecen las preguntas que sí aplican a tu
        caso. Sin coste y en unos 3 minutos. Cuando termines, Startidea recibe
        el briefing antes de llamarte.
      </p>
      <p class="mt-3 max-w-measure text-sm text-ink-mute">
        ¿Buscas concretamente una web? Usa el
        <a href="/diagnostico/brief-web" class="underline decoration-magenta/40 underline-offset-2 hover:text-magenta">briefing de web</a>:
        respondes, subes tu logo y colores, y obtienes un documento listo para empezar.
      </p>

      <!-- Stepper: los 5 pasos siempre visibles -->
      <ol
        class="mt-8 flex max-w-2xl flex-wrap gap-x-5 gap-y-2 font-mono text-[10px] uppercase tracking-widest"
        aria-hidden="true"
      >
        {STEP_NAMES.map((nombre, i) => (
          <li data-step-dot class="flex items-center gap-2 text-ink-mute transition-colors">
            <span class="dot inline-block h-1.5 w-1.5 bg-ink/25 transition-colors"></span>
            {i + 1} · {nombre}
          </li>
        ))}
      </ol>
      <div class="mt-3 flex max-w-2xl items-center gap-2" aria-hidden="true">
        <div class="h-1 flex-1 overflow-hidden bg-ink/15">
          <div
            data-progress
            class="h-full bg-magenta transition-all duration-300"
            style="width: 20%"
          ></div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-paper py-12 md:py-16">
    <div class="container-x">
      <form
        id="diag-form"
        data-intake-url={INTAKE_URL}
        class="max-w-2xl space-y-10"
        novalidate
      >
        <!-- honeypot anti-bot -->
        <input
          type="text"
          name="honeypot"
          tabindex="-1"
          autocomplete="off"
          class="absolute -left-[9999px]"
          aria-hidden="true"
        />

        <!-- El árbol fija estos dos valores -->
        <input type="hidden" name="audience" value="" />
        <input type="hidden" name="subType" value="" />

        <p class="text-xs text-ink-mute">
          <span class="text-magenta" aria-hidden="true">*</span> Campo obligatorio.
        </p>

        <!-- ============ PASO 1: PERFIL (audience + subType) ============ -->
        <fieldset data-step="1" class="space-y-6">
          <div>
            <h2 class="font-display text-2xl text-ink">¿Quién eres?</h2>
            <p class="mt-2 text-sm text-ink-mute">
              Las cuatro ramas, a la vista. Toca el tipo que mejor te describe
              y el formulario se adapta a tu caso.
            </p>
          </div>

          <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            {AUDIENCES.map((aud) => (
              <div class="space-y-3 border border-ink/20 bg-paper p-5">
                <div>
                  <span class="block font-mono text-[10px] uppercase tracking-widest text-magenta">
                    {aud.label}
                  </span>
                  <p class="mt-1 text-xs text-ink-mute">{aud.desc}</p>
                </div>
                <div class="flex flex-wrap gap-2">
                  {aud.subs.map((sub) => (
                    <button
                      type="button"
                      data-pick
                      data-audience={aud.id}
                      data-audience-label={aud.label}
                      data-sub={sub.id}
                      data-sub-label={sub.label}
                      class="min-h-[44px] border border-ink/25 px-4 py-2 text-sm text-ink transition-colors hover:border-magenta hover:text-magenta focus:outline-none focus-visible:border-magenta focus-visible:ring-1 focus-visible:ring-magenta"
                    >
                      {sub.label}
                    </button>
                  ))}
                </div>
              </div>
            ))}
          </div>
          <p class="text-xs text-ink-mute">
            ¿Ninguna encaja del todo? Elige la más parecida: en el paso del reto
            podrás contarlo con tus palabras.
          </p>
        </fieldset>

        <!-- ============ PASO 2: SERVICIOS + ETAPA ============ -->
        <fieldset data-step="2" class="hidden space-y-8">
          <div>
            <h2 class="font-display text-2xl text-ink">¿Qué necesitas?</h2>
            <p class="mt-2 text-sm text-ink-mute">
              Perfil elegido:
              <span class="font-medium text-magenta" data-profile-recap>—</span>.
              Marca todo lo que te interese, sin compromiso: con esto Startidea
              prepara tu presupuesto orientativo y una hoja de ruta a medida —
              la recibirás por email, no aquí.
            </p>
          </div>

          <div class="space-y-6">
            <span class="block text-sm font-medium text-ink">Servicios de Startidea</span>
            {GRUPOS.map((grupo) => (
              <div class="space-y-2">
                <span class="block font-mono text-[10px] uppercase tracking-widest text-magenta">
                  {grupo.nombre}
                </span>
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                  {grupo.items.map((it) => (
                    <label class="flex cursor-pointer items-center gap-3 border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm">
                      <input type="checkbox" name="services" value={it.id} class="accent-magenta" />
                      <span>{it.nombre}</span>
                    </label>
                  ))}
                </div>
              </div>
            ))}
            <div class="space-y-2 border-t border-ink/15 pt-4">
              <label for="servicesOther" class="block text-sm font-medium text-ink">
                ¿Algo que no está en la lista? <span class="text-ink-mute">(opcional)</span>
              </label>
              <input type="text" id="servicesOther" name="servicesOther" maxlength="200"
                placeholder="Cuéntanos qué necesitas y lo valoramos."
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none" />
            </div>
          </div>

          <div class="space-y-3 border-t border-ink/15 pt-6">
            <span class="block text-sm font-medium text-ink">
              <span data-stage-label-default>¿En qué etapa estáis?</span>
              <span data-stage-label-emprendedor class="hidden">¿En qué momento estás?</span>
              <span class="text-magenta" aria-hidden="true">*</span>
            </span>
            <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
              {[
                ["idea", "Idea en formación"],
                ["lanzamiento", "Lanzamiento reciente"],
                ["consolidado", "Proyecto consolidado"],
                ["replanteamiento", "Replanteamiento estratégico"],
              ].map(([v, label]) => (
                <label class="flex cursor-pointer items-center gap-3 border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm">
                  <input type="radio" name="stage" value={v} required />
                  <span>{label}</span>
                </label>
              ))}
            </div>
          </div>

          <div class="flex justify-between pt-4">
            <button type="button" data-prev class="btn-ghost">← Al perfil</button>
            <button type="button" data-next class="btn">Siguiente →</button>
          </div>
        </fieldset>

        <!-- ============ PASO 3: RETO + PREGUNTAS ADAPTATIVAS ============ -->
        <fieldset data-step="3" class="hidden space-y-8">
          <div>
            <h2 class="font-display text-2xl text-ink">El reto concreto</h2>
            <p class="mt-2 text-sm text-ink-mute">
              Sé directo. No hace falta que esté redactado bonito.
            </p>
          </div>

          <div class="space-y-2">
            <label for="challenge" class="block text-sm font-medium text-ink">
              ¿Qué reto quieres resolver? <span class="text-magenta" aria-hidden="true">*</span>
            </label>
            <textarea id="challenge" name="challenge" required minlength="20" maxlength="2000" rows="6"
              placeholder="Ej: Necesitamos profesionalizar la comunicación externa. Tenemos 1.200 socios pero la captación nueva está estancada hace dos años."
              class="w-full resize-y border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none"></textarea>
            <p class="text-xs text-ink-mute"><span data-count-challenge>0</span> / 2000</p>
          </div>

          <div class="space-y-2">
            <label for="triedBefore" class="block text-sm font-medium text-ink">
              ¿Qué habéis probado antes? <span class="text-ink-mute">(opcional)</span>
            </label>
            <textarea id="triedBefore" name="triedBefore" maxlength="1500" rows="3"
              placeholder="Lo que habéis intentado y por qué no terminó de funcionar."
              class="w-full resize-y border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none"></textarea>
          </div>

          <!-- Preguntas adaptativas — solo aparecen si el audience lo justifica -->

          <div data-extra-for="entidad-social" class="hidden space-y-5 border-t border-ink/15 pt-6">
            <div>
              <h3 class="font-display text-lg text-ink">Sobre tu entidad</h3>
              <p class="mt-1 text-sm text-ink-mute">Solo si te resulta natural responder.</p>
            </div>
            <div class="space-y-2">
              <label for="mission" class="block text-sm font-medium text-ink">Misión en una frase</label>
              <input type="text" id="mission" name="mission" maxlength="200"
                placeholder="ej. acompañamos a familias acogedoras en Granada"
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none" />
            </div>
            <div class="space-y-3">
              <span class="block text-sm font-medium text-ink">Estado legal de la entidad</span>
              <div class="grid grid-cols-1 gap-2 md:grid-cols-3">
                {[
                  ["constituida", "Constituida y operativa"],
                  ["tramite", "En trámite de constitución"],
                  ["no-formalizada", "Aún no formalizada"],
                ].map(([v, label]) => (
                  <label class="flex cursor-pointer items-center justify-center border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm has-[input:checked]:font-medium has-[input:checked]:text-magenta">
                    <input type="radio" name="legalStatus" value={v} class="sr-only" />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
              <p class="text-xs text-ink-mute">Esto cambia la estrategia (ej. deducción fiscal solo aplica si hay utilidad pública o fundación constituida).</p>
            </div>
            <div class="space-y-3">
              <span class="block text-sm font-medium text-ink">Fuentes de financiación actuales</span>
              <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                {[
                  ["subvenciones", "Subvenciones públicas"],
                  ["cuotas", "Cuotas de socios/as"],
                  ["donaciones", "Donaciones puntuales"],
                  ["empresas", "Empresas (patrocinio, RSC)"],
                  ["ventas", "Venta de servicios o productos"],
                  ["otras", "Otras"],
                ].map(([v, label]) => (
                  <label class="flex cursor-pointer items-center gap-3 border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm">
                    <input type="checkbox" name="fundingSources" value={v} class="accent-magenta" />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </div>
            <div class="space-y-3">
              <span class="block text-sm font-medium text-ink">¿Qué peso tiene tu fuente principal?</span>
              <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
                {[
                  ["<25", "< 25%"],
                  ["25-50", "25 - 50%"],
                  ["50-75", "50 - 75%"],
                  [">75", "> 75%"],
                ].map(([v, label]) => (
                  <label class="flex cursor-pointer items-center justify-center border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm has-[input:checked]:font-medium has-[input:checked]:text-magenta">
                    <input type="radio" name="fundingMainShare" value={v} class="sr-only" />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
              <p class="text-xs text-ink-mute">Una entidad con más del 75% en una sola fuente tiene un riesgo de dependencia que cambia la estrategia.</p>
            </div>
            <div class="space-y-3">
              <span class="block text-sm font-medium text-ink">Base actual de socios/donantes/seguidores</span>
              <div class="grid grid-cols-2 gap-2 md:grid-cols-3">
                {[
                  ["ninguna", "Ninguna todavía"],
                  ["<50", "< 50"],
                  ["50-200", "50 - 200"],
                  ["200-500", "200 - 500"],
                  ["500-2000", "500 - 2.000"],
                  ["2000+", "+ 2.000"],
                ].map(([v, label]) => (
                  <label class="flex cursor-pointer items-center justify-center border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm has-[input:checked]:font-medium has-[input:checked]:text-magenta">
                    <input type="radio" name="memberCount" value={v} class="sr-only" />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </div>
            <div class="space-y-2">
              <label for="captationGoal" class="block text-sm font-medium text-ink">Objetivo de captación concreto</label>
              <input type="text" id="captationGoal" name="captationGoal" maxlength="200"
                placeholder="ej. 100 socios a 150€/año con retención a largo plazo"
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none" />
            </div>
          </div>

          <div data-extra-for="empresa" class="hidden space-y-5 border-t border-ink/15 pt-6">
            <div>
              <h3 class="font-display text-lg text-ink">Sobre tu empresa</h3>
              <p class="mt-1 text-sm text-ink-mute">Solo si te resulta natural responder.</p>
            </div>
            <div class="space-y-2">
              <label for="sector" class="block text-sm font-medium text-ink">Sector de actividad</label>
              <input type="text" id="sector" name="sector" maxlength="120"
                placeholder="ej. hostelería, tecnología, retail, servicios profesionales"
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none" />
            </div>
            <div class="space-y-3">
              <span class="block text-sm font-medium text-ink">¿Tenéis hoy equipo interno o agencia externa de comunicación?</span>
              <div class="grid grid-cols-1 gap-2 md:grid-cols-3">
                {[["interno","Equipo interno"],["agencia","Agencia externa"],["ninguno","Ninguno de los dos"]].map(([v,label]) => (
                  <label class="flex cursor-pointer items-center justify-center border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm has-[input:checked]:font-medium has-[input:checked]:text-magenta">
                    <input type="radio" name="hasAgency" value={v} class="sr-only" />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </div>
            <div class="space-y-3">
              <span class="block text-sm font-medium text-ink">¿Tenéis programa ASE o de propósito activo?</span>
              <div class="grid grid-cols-3 gap-2">
                {[["si","Sí"],["no","No"],["explorando","Lo estamos explorando"]].map(([v,label]) => (
                  <label class="flex cursor-pointer items-center justify-center border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm has-[input:checked]:font-medium has-[input:checked]:text-magenta">
                    <input type="radio" name="asePresent" value={v} class="sr-only" />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </div>
            <div class="space-y-2">
              <label for="teamSize" class="block text-sm font-medium text-ink">Tamaño del equipo (opcional)</label>
              <input type="text" id="teamSize" name="teamSize" maxlength="40" placeholder="ej. 25 personas"
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none" />
            </div>
          </div>

          <div data-extra-for="emprendedor" class="hidden space-y-5 border-t border-ink/15 pt-6">
            <div>
              <h3 class="font-display text-lg text-ink">Sobre tu proyecto</h3>
              <p class="mt-1 text-sm text-ink-mute">Solo si te resulta natural responder.</p>
            </div>
            <div class="space-y-2">
              <label for="target" class="block text-sm font-medium text-ink">¿A quién va dirigido? (tu cliente ideal)</label>
              <input type="text" id="target" name="target" maxlength="200"
                placeholder="ej. pymes de menos de 20 empleados en Andalucía"
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none" />
            </div>
            <div class="space-y-2">
              <label for="emp_team" class="block text-sm font-medium text-ink">¿Lo haces solo/a o en equipo?</label>
              <input type="text" id="emp_team" name="emp_team" maxlength="120"
                placeholder="ej. somos 2 cofundadoras + 1 freelance"
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none" />
            </div>
            <div class="space-y-3">
              <span class="block text-sm font-medium text-ink">¿Tienes financiación o ingresos?</span>
              <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
                {[
                  ["ninguna","Aún no"],
                  ["propia","Solo capital propio"],
                  ["clientes","Primeros clientes"],
                  ["inversor","Inversión externa"],
                ].map(([v,label]) => (
                  <label class="flex cursor-pointer items-center justify-center border border-ink/20 p-3 text-sm hover:border-magenta/60 has-[input:checked]:border-magenta has-[input:checked]:bg-paper-warm has-[input:checked]:font-medium has-[input:checked]:text-magenta">
                    <input type="radio" name="emp_funding" value={v} class="sr-only" />
                    <span>{label}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <div data-extra-for="institucion" class="hidden space-y-5 border-t border-ink/15 pt-6">
            <div>
              <h3 class="font-display text-lg text-ink">Sobre tu institución</h3>
              <p class="mt-1 text-sm text-ink-mute">Solo si te resulta natural responder.</p>
            </div>
            <div class="space-y-2">
              <label for="communitySize" class="block text-sm font-medium text-ink">Tamaño aproximado de la comunidad a la que atendéis</label>
              <input type="text" id="communitySize" name="communitySize" maxlength="200"
                placeholder="ej. 4.000 feligreses, 800 alumnos, 200 empleados…"
                class="w-full border border-ink/20 bg-paper px-4 py-3 text-ink focus:border-magenta focus:outline-none" />
            </div>
            <div class="space-y-3">
              <span class="block text-sm font-medium text-ink">¿Quién decide sobre proyectos de comunicación o digitales?</span>
              <div class="grid grid-cols-1 gap-2 md:grid-cols-3">
                {[["direccion","La dirección directamente"],["comite","Un comité o patronato"],["superior","Depende de una entidad superior"]].map(([v,label]) => (
