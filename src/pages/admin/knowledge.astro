---
export const prerender = false;
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { isAdminLoggedIn, setAdminSession, getAdminToken } from '@/lib/admin-session';
import { listarDocs, buscarChunks, embeddingsActivos, type DocRow, type ChunkHit } from '@/lib/knowledge-db';

// Auth canónica del panel: cookie de sesión = sha256(ADMIN_TOKEN) (misma que el
// resto de /admin). Login SOLO por POST → nunca el token en query string (logs,
// historial, Referer), nunca el token plano en cookie.
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData().catch(() => null);
  const token = (form?.get('token') ?? '').toString();
  if (token && setAdminSession(Astro.cookies, token)) {
    return Astro.redirect('/admin/knowledge', 303);
  }
}

const noTokenConfigured = !getAdminToken();
const authed = isAdminLoggedIn(Astro.cookies);

let archivos: { id: string; size: number; preview: string }[] = [];
if (authed) {
  try {
    const entries = await getCollection('knowledge');
    entries.sort((a, b) => a.id.localeCompare(b.id));
    archivos = entries.map((e) => ({
      id: e.id,
      size: e.body.length,
      preview: e.body,
    }));
  } catch (err) {
    console.error('[admin/knowledge] error', err);
  }
}

// ─── Entrenar a Lazo con documentos (knowledge.db) ─────────────────────
const params = Astro.url.searchParams;
const subido = params.get('subido');
const erroresSubida = params.get('errores');
// Errores por fichero que manda knowledge-upload en el 303 (unidos por ' · ').
const detalle = (params.get('detalle') ?? '').trim().slice(0, 600);
const borrado = params.get('borrado');
const q = (params.get('q') ?? '').trim().slice(0, 300);

// Códigos de error de los endpoints (fallo() en src/lib/knowledge-auth.ts)
// traducidos a frases. Map y no objeto: la clave viene de la URL.
const ERROR_LABEL = new Map<string, string>([
  ['no_autorizado', 'La sesión ha caducado: vuelve a entrar.'],
  ['origen', 'Origen no permitido.'],
  ['rate_limit', 'Demasiadas subidas seguidas: espera un rato y vuelve a intentarlo.'],
  ['sin_content_length', 'Hace falta Content-Length: el navegador no ha declarado el tamaño de la subida.'],
  ['demasiado_grande', 'La subida supera 40 MB.'],
  ['demasiados_ficheros', 'Máximo 8 ficheros por subida.'],
  ['sin_ficheros', 'No llegó ningún fichero.'],
  ['parse', 'No se pudo leer el formulario: vuelve a intentarlo.'],
  ['id', 'Identificador de documento no válido.'],
  ['internal', 'Error interno al procesar la petición: revisa el log del servidor.'],
]);
const errorCode = (params.get('error') ?? '').trim().slice(0, 40);
const errorTexto = errorCode ? (ERROR_LABEL.get(errorCode) ?? `Error: ${errorCode}`) : '';

// Búsqueda semántica: solo con PLANO_EMBEDDINGS=on (+ OPENROUTER_API_KEY).
const semantica = embeddingsActivos();

let docs: DocRow[] = [];
let resultados: ChunkHit[] = [];
if (authed) {
  try {
    docs = listarDocs();
  } catch (err) {
    console.error('[admin/knowledge] no se pudo listar knowledge.db', err);
  }
  if (q) {
    try {
      resultados = await buscarChunks(q, 6);
    } catch (err) {
      console.error('[admin/knowledge] búsqueda de prueba', err);
    }
  }
}

function fmtFecha(ms: number): string {
  return new Date(ms).toLocaleString('es-ES', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
}
function fmtNum(n: number): string {
  return n.toLocaleString('es-ES');
}
function recortar(s: string, max = 700): string {
  return s.length > max ? `${s.slice(0, max)}…` : s;
}
const FUENTE_LABEL: Record<ChunkHit['fuente'], string> = { fts: 'texto', vec: 'vector', ambos: 'texto + vector' };
---

<Base
  title="Admin · Knowledge base · Startidea"
  description="Panel admin de Startidea para gestión del conocimiento del asistente IA."
  ogSlug="page/404"
  noindex={true}
>
  <section class="bg-paper py-16 md:py-24">
    <div class="container-x">
      <a href="/admin" class="font-mono text-[11px] uppercase tracking-widest text-ink/60 hover:text-magenta">← Panel</a>
      <span class="label mt-6 block">— Admin · Knowledge base</span>
      <h1 class="mt-4 font-display text-display-md leading-tight text-ink">
        Conocimiento del <em class="italic text-magenta">asistente</em>.
      </h1>

      {errorTexto && (
        <div class="mt-6 max-w-2xl border border-magenta bg-paper-warm p-4 text-sm text-magenta" role="alert">
          {errorTexto}
        </div>
      )}

      {noTokenConfigured && (
        <div class="mt-10 border-2 border-magenta bg-paper-warm p-6">
          <p class="font-display text-xl text-magenta">⚠ Falta configurar <code class="font-mono">ADMIN_TOKEN</code> en Coolify.</p>
          <p class="mt-3 max-w-measure text-sm text-ink/85">
            Sin esa variable nadie puede entrar — ni siquiera tú. En Coolify → Secrets → añade <code class="font-mono">ADMIN_TOKEN</code> y reinicia. Después entra en <code class="font-mono">/admin/knowledge</code> con el token.
          </p>
        </div>
      )}

      {!authed && !noTokenConfigured && (
        <form method="post" class="mt-10 max-w-md space-y-3">
          <p class="label">— Acceso</p>
          <input
            name="token"
            type="password"
            required
            placeholder="Token admin"
            class="w-full border border-ink bg-paper px-4 py-3 font-mono text-sm text-ink placeholder:text-ink/75 focus:border-magenta focus:outline-none focus:ring-2 focus:ring-magenta/40"
          />
          <button type="submit" class="btn">
            Entrar
            <span aria-hidden="true">→</span>
          </button>
        </form>
      )}

      {authed && (
        <>
          {/* ── Entrenar a Lazo con documentos ─────────────────────────── */}
          <div id="documentos" class="mt-12 border-t-2 border-ink pt-8">
            <span class="label">— Entrenar a Lazo con documentos</span>
            <h2 class="mt-3 font-display text-3xl leading-tight text-ink">
              Lo que Lazo puede <em class="italic text-magenta">consultar</em>.
            </h2>
            <p class="mt-3 max-w-measure text-sm text-ink/75">
              Cada documento se trocea e indexa en <code class="font-mono">knowledge.db</code>. En cada turno del chat, Lazo recibe hasta 6 fragmentos relevantes al último mensaje. Las fichas <code class="font-mono">.md</code> de abajo siguen siendo su identidad base.
            </p>
            <p class="mt-2 max-w-measure font-mono text-xs text-ink/70" data-semantica={semantica ? 'on' : 'off'}>
              {semantica
                ? 'Búsqueda semántica: activada. Los embeddings se calculan al subir y cada turno del chat consulta también por vector.'
                : 'Búsqueda semántica: desactivada (PLANO_EMBEDDINGS=on para activarla). El buscador funciona solo por texto; coste y detalles en docs/entrenar-lazo.md.'}
            </p>

            {subido !== null && (
              <div class={`mt-6 max-w-2xl border p-4 text-sm ${Number(subido) > 0 ? 'border-ink/30 bg-paper-warm text-ink' : 'border-magenta bg-paper-warm text-magenta'}`} role="status">
                <p>
                  {Number(subido) > 0
                    ? `Indexado${Number(subido) === 1 ? '' : 's'} ${subido} documento${Number(subido) === 1 ? '' : 's'}. ${semantica ? 'Los embeddings se calculan en segundo plano; el buscador por texto ya funciona.' : 'El buscador por texto ya funciona.'}`
                    : 'No se indexó ningún documento.'}
                  {erroresSubida && ` ${erroresSubida} fichero${erroresSubida === '1' ? '' : 's'} con error:`}
                </p>
                {detalle && <p class="mt-2 whitespace-pre-line font-mono text-xs text-ink/80">{detalle}</p>}
                {erroresSubida && !detalle && <p class="mt-2 text-xs text-ink/70">Sin detalle disponible: revisa el log del servidor.</p>}
              </div>
            )}
            {borrado !== null && (
              <div class="mt-6 border border-ink/30 bg-paper-warm p-4 text-sm text-ink" role="status">
                {borrado === '1' ? 'Documento borrado del índice.' : 'Ese documento ya no existía.'}
              </div>
            )}

            <form
              method="post"
              action="/api/admin/knowledge-upload"
              enctype="multipart/form-data"
              class="mt-8 grid max-w-2xl gap-4"
              onsubmit="var b=this.querySelector('button[type=submit]');if(b){b.disabled=true;b.textContent='Subiendo e indexando…';}"
            >
              <label class="block">
                <span class="font-mono text-[10px] uppercase tracking-widest text-ink-mute">Ficheros (hasta 8, 15 MB cada uno, 40 MB en total)</span>
                <input
                  name="files"
                  type="file"
                  multiple
                  required
                  accept=".pdf,.docx,.txt,.md,.csv,.xlsx,.xls"
                  class="mt-2 block w-full border border-ink bg-paper px-4 py-3 text-sm text-ink file:mr-4 file:border-0 file:bg-ink file:px-3 file:py-1.5 file:font-mono file:text-[11px] file:uppercase file:tracking-widest file:text-paper"
                />
              </label>
              <label class="block">
                <span class="font-mono text-[10px] uppercase tracking-widest text-ink-mute">Título (opcional, se aplica a todos)</span>
                <input
                  name="titulo"
                  type="text"
                  maxlength="200"
                  placeholder="Dossier de servicios 2026"
                  class="mt-2 w-full border border-ink bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/50 focus:border-magenta focus:outline-none focus:ring-2 focus:ring-magenta/40"
                />
              </label>
              <label class="block">
                <span class="font-mono text-[10px] uppercase tracking-widest text-ink-mute">Notas internas (opcional)</span>
                <textarea
                  name="notas"
                  rows="2"
                  maxlength="1000"
                  placeholder="De dónde sale, hasta cuándo vale…"
                  class="mt-2 w-full border border-ink bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/50 focus:border-magenta focus:outline-none focus:ring-2 focus:ring-magenta/40"
                ></textarea>
              </label>
              <div class="flex flex-wrap items-center gap-4">
                <button type="submit" class="btn">
                  Subir e indexar
                  <span aria-hidden="true">→</span>
                </button>
                <a href="/admin/knowledge#buscador" class="btn-ghost">Probar el buscador</a>
              </div>
            </form>

            <div class="mt-6 max-w-2xl border border-magenta/60 bg-paper-warm p-4 text-sm text-ink/85">
              <p class="font-mono text-[10px] uppercase tracking-widest text-magenta">Qué NO subir</p>
              <ul class="mt-2 list-disc space-y-1 pl-5">
                <li>Ningún documento interno de estrategia ni de planificación: lo que entra aquí puede acabar en una respuesta pública del chat.</li>
                <li>Contratos, facturas o expedientes con datos de terceros (nombres, NIF, importes de clientes).</li>
                <li>Claves, accesos o tokens en cualquier formato.</li>
              </ul>
              <p class="mt-2 text-ink/70">Sí: dossieres de servicio, casos autorizados, método, FAQ, tarifas orientativas. Guía completa en <code class="font-mono">docs/entrenar-lazo.md</code>.</p>
            </div>

            {docs.length > 0 ? (
              <div class="mt-10 overflow-x-auto">
                <table class="w-full min-w-[720px] border-collapse text-sm">
                  <thead>
                    <tr class="border-b border-ink text-left font-mono text-[10px] uppercase tracking-widest text-ink-mute">
                      <th class="py-2 pr-3 font-normal">Fichero</th>
                      <th class="py-2 pr-3 font-normal">Título</th>
                      <th class="py-2 pr-3 text-right font-normal">Caracteres</th>
                      <th class="py-2 pr-3 text-right font-normal">Trozos</th>
                      <th class="py-2 pr-3 font-normal">Embebido</th>
                      <th class="py-2 pr-3 font-normal">Fecha</th>
                      <th class="py-2 font-normal"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {docs.map((d) => (
                      <tr class="border-b border-ink/10 align-top">
                        <td class="py-3 pr-3">
                          <code class="font-mono text-xs text-ink">{d.nombre}</code>
                          {d.notas && <p class="mt-1 text-xs text-ink/60">{d.notas}</p>}
                        </td>
                        <td class="py-3 pr-3 text-ink/85">{d.titulo || '—'}</td>
                        <td class="py-3 pr-3 text-right tabular-nums text-ink/85">{fmtNum(d.chars)}</td>
                        <td class="py-3 pr-3 text-right tabular-nums text-ink/85">{fmtNum(d.n_chunks)}</td>
                        <td class="py-3 pr-3">
                          <span class={`font-mono text-[10px] uppercase tracking-widest ${d.embebido ? 'text-ink' : 'text-ink-mute'}`}>{d.embebido ? 'sí' : 'no'}</span>
                        </td>
                        <td class="py-3 pr-3 whitespace-nowrap text-xs text-ink/70">{fmtFecha(d.created_at)}</td>
                        <td class="py-3 text-right">
                          <form method="post" action="/api/admin/knowledge-delete" onsubmit="return confirm('¿Borrar este documento del índice de Lazo?')">
                            <input type="hidden" name="id" value={d.id} />
                            <button type="submit" class="font-mono text-[10px] uppercase tracking-widest text-magenta hover:underline">Borrar</button>
                          </form>
                        </td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            ) : (
              <p class="mt-10 font-mono text-[11px] uppercase tracking-widest text-ink-mute">Todavía no hay documentos indexados.</p>
            )}

            {/* ── Buscador de prueba ─────────────────────────────────────── */}
            <div id="buscador" class="mt-12 border-t border-ink/15 pt-6">
              <span class="label">— Buscador de prueba</span>
              <p class="mt-2 max-w-measure text-sm text-ink/75">Escribe lo que preguntaría una persona en el chat y verás los fragmentos que Lazo recibiría (hasta 6).</p>
              <form method="get" action="/admin/knowledge#buscador" class="mt-4 flex max-w-2xl flex-wrap gap-3">
                <input
                  name="q"
                  type="search"
                  value={q}
                  maxlength="300"
                  placeholder="¿Cuánto cuesta tramitar una subvención?"
                  class="min-w-0 flex-1 border border-ink bg-paper px-4 py-3 text-sm text-ink placeholder:text-ink/50 focus:border-magenta focus:outline-none focus:ring-2 focus:ring-magenta/40"
                />
                <button type="submit" class="btn">Buscar</button>
              </form>

              {q && (
                resultados.length > 0 ? (
                  <ol class="mt-6 space-y-4">
                    {resultados.map((r, i) => (
                      <li class="border border-ink/15 bg-paper-warm p-4">
                        <div class="flex flex-wrap items-baseline justify-between gap-2 font-mono text-[10px] uppercase tracking-widest text-ink-mute">
                          <span>#{i + 1} · <code class="normal-case">{r.nombre}</code> · trozo {r.idx}{r.titulo ? ` · ${r.titulo}` : ''}</span>
                          <span>score {r.score.toFixed(4)} · {FUENTE_LABEL[r.fuente]}</span>
                        </div>
                        <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-ink/85">{recortar(r.texto)}</p>
                      </li>
                    ))}
                  </ol>
                ) : (
                  <p class="mt-6 font-mono text-[11px] uppercase tracking-widest text-ink-mute">Sin fragmentos para «{q}».</p>
                )
              )}
            </div>
          </div>

          {/* ── Fichas .md del repo (identidad base) ───────────────────── */}
          <div class="mt-16 border-t-2 border-ink pt-8">
            <span class="label">— Fichas base (repo)</span>
            <p class="mt-3 max-w-measure text-sm text-ink/75">
              Estos archivos <code class="font-mono">.md</code> alimentan al asistente IA antes de cada respuesta. Para editarlos, modifica el repo y haz <code class="font-mono">git push</code> — el deploy recarga la knowledge base.
            </p>
          </div>

          <div class="mt-12 space-y-10">
            {archivos.map((f) => (
              <article class="border-t border-ink/15 pt-6">
                <header class="flex flex-wrap items-baseline justify-between gap-3 border-b border-ink/10 pb-2">
                  <h2 class="font-display text-2xl leading-tight text-ink">
                    <code class="font-mono text-base">{f.id}</code>
                  </h2>
                  <span class="font-mono text-[11px] uppercase tracking-widest text-ink-mute">
                    {f.size.toLocaleString('es-ES')} caracteres
                  </span>
                </header>
                <pre class="mt-4 max-h-[420px] overflow-auto bg-paper-warm p-4 text-xs leading-relaxed text-ink/85">{f.preview}</pre>
              </article>
            ))}
          </div>

          <div class="mt-12 border-t border-ink/15 pt-6 font-mono text-[11px] uppercase tracking-widest text-ink-mute">
            <p>Total de archivos: {archivos.length}</p>
            <p class="mt-2">Para añadir uno nuevo: crea <code class="font-mono">src/content/knowledge/05-mi-tema.md</code> y haz git push.</p>
          </div>
        </>
      )}
    </div>
  </section>
</Base>
