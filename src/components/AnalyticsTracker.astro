---
/**
 * Eventos mínimos al transporte GA4 después de aceptación explícita.
 *
 * Expone window.stTrack(event, params) para llamadas programáticas
 * (chat, form submit, etc.) y monta listeners que disparan
 * automáticamente:
 *
 *   - cta_click       en cualquier elemento con [data-track="cta"]
 *                     con su identificador editorial data-track-id="..."
 *   - file_download   en <a> con [data-track="download"]
 *                     enviando solo la extensión, sin nombre ni URL del archivo
 *
 * AnalyticsPrivacy aplica la elección del banner antes de este componente.
 * Los recorridos usan solo rutas públicas,
 * nunca parámetros de URL, texto de formularios ni conversaciones.
 */
---

<script is:inline>
  (function () {
    window.dataLayer = window.dataLayer || [];
    var pagePath = location.pathname.replace(/\/$/, '') || '/';
    var privacy = window.stPrivacy;
    var acceptancePage = pagePath === '/diagnostico/gracias';

    window.stTrack = function (event, params) {
      if (!privacy || !privacy.hasConsent()) return false;
      var formType = params && params.form_type;
      var acceptedForm = event === 'form_submit' && acceptancePage &&
        (formType === 'diagnostico' || formType === 'presupuesto');
      if (!privacy.isAllowed() && !acceptedForm) return false;
      // La confirmación solo llama tras consumir una marca de aceptación válida.
      if (event === 'form_submit' && !acceptedForm) return false;
      try {
        var eventParams = Object.assign({}, acceptedForm ? { form_type: formType } : (params || {}), {
          page_location: privacy.pageLocation,
          page_referrer: privacy.pageReferrer,
        });
        // Ningún texto capturado del DOM ni campos libres llegan a la etiqueta.
        delete eventParams.cta_text;
        delete eventParams.link_url;
        delete eventParams.file_name;
        if (typeof window.stSendAnalyticsEvent === 'function') {
          return window.stSendAnalyticsEvent(event, eventParams);
        }
        return false;
      } catch (_) { return false; }
    };

    // Atribución opcional: nunca almacenar antes de aceptar ni conservar URLs
    // completas de referentes o términos libres de campañas.
    var ATTR_KEY = 'st_attribution';
    function originOnly(value) {
      try { return new URL(value).origin + '/'; } catch (_) { return ''; }
    }
    function campaign(value) {
      return typeof value === 'string' && /^[a-zA-Z0-9_.-]{1,80}$/.test(value) ? value : '';
    }
    function cleanAttribution(value) {
      var landing = value && value.landing_page;
      // Solo conservar una ruta de entrada de la taxonomía pública conocida.
      return {
        utm_source: campaign(value && value.utm_source),
        utm_medium: campaign(value && value.utm_medium),
        utm_campaign: campaign(value && value.utm_campaign),
        landing_page: typeof landing === 'string' && publicKind(landing) ? landing : '/',
        referrer: originOnly(value && value.referrer),
      };
    }
    function captureAttribution() {
      if (!privacy || !privacy.isAllowed()) return;
      try {
        var stored = localStorage.getItem(ATTR_KEY);
        var p = new URLSearchParams(location.search);
        var value = stored ? JSON.parse(stored) : {
          utm_source: p.get('utm_source'), utm_medium: p.get('utm_medium'),
          utm_campaign: p.get('utm_campaign'), landing_page: pagePath,
          referrer: document.referrer,
        };
        localStorage.setItem(ATTR_KEY, JSON.stringify(cleanAttribution(value)));
      } catch (_) { /* El formulario funciona sin atribución. */ }
    }
    window.stAttribution = function () {
      if (!privacy || !privacy.hasConsent()) return {};
      try { return cleanAttribution(JSON.parse(localStorage.getItem(ATTR_KEY) || '{}')); }
      catch (_) { return {}; }
    };
    function clearAttribution() {
      try { localStorage.removeItem(ATTR_KEY); } catch (_) {}
    }
    document.addEventListener('cookieconsent:essential', clearAttribution);
    if (!privacy || !privacy.hasConsent()) clearAttribution();

    // ── view_service: dispara al cargar una ficha de servicio (centralizado, sin
    //    tocar cada página). Mide qué servicios se ven, no solo los que convierten.
    var SERVICES = ['/comunicacion', '/redes-sociales-granada', '/publicidad', '/consultoria', '/audiovisual', '/tecnologia',
      '/mantenimiento-web', '/ia-administraciones', '/fundraising', '/donaciones-bizum-ong',
      '/proteccion-digital', '/google-ad-grants', '/hub', '/merchandising',
      '/agentes-ia', '/financiacion-empresas', '/copiloto-subvenciones', '/redes-sociales-ia'];
    function publicKind(path) {
      if (SERVICES.indexOf(path) !== -1) return 'servicio';
      if (path !== '/laboratorio/cursos/gracias' && /^\/laboratorio\/cursos\/[a-z0-9-]+$/.test(path)) return 'curso';
      if (/^\/notas\/[a-z0-9-]+$/.test(path)) return 'nota';
      if (path === '/contacto') return 'contacto';
      if (['/', '/que-hacemos', '/notas', '/laboratorio', '/laboratorio/cursos'].indexOf(path) !== -1) return 'indice';
      return null;
    }
    var viewRecorded = false;
    function recordPageContext() {
      if (!privacy || !privacy.isAllowed() || viewRecorded) return;
      viewRecorded = true;
      captureAttribution();
      if (SERVICES.indexOf(pagePath) !== -1) {
        window.stTrack('view_service', { service: pagePath.slice(1), page_path: pagePath });
      }
      if (publicKind(pagePath) === 'curso') {
        window.stTrack('view_course', { course_id: pagePath.split('/').pop(), page_path: pagePath });
      }
    }
    document.addEventListener('cookieconsent:all', recordPageContext);
    recordPageContext();

    // Clic editorial dentro de <main>: permite distinguir nota → servicio,
    // servicio → curso y consulta. Un clic no equivale a un lead ni a una venta.
    document.addEventListener('click', function (e) {
      var link = e.target.closest && e.target.closest('a[href]');
      if (!link || !link.closest('main') || !publicKind(pagePath)) return;
      try {
        var url = new URL(link.getAttribute('href'), location.href);
        var targetPath = url.pathname.replace(/\/$/, '') || '/';
        var kind = publicKind(targetPath) || {
          '/subvenciones/presentar/nuevo': 'solicitud',
          '/subvenciones/crear-alerta': 'aviso',
          '/subvenciones/catalogo': 'catalogo',
        }[targetPath];
        if (url.origin !== location.origin || !kind || targetPath === pagePath) return;
        window.stTrack('internal_link_click', {
          source_path: pagePath,
          target_path: targetPath,
          source_type: publicKind(pagePath),
          target_type: kind,
          link_type: ['servicio', 'curso', 'nota'].indexOf(link.getAttribute('data-link-type')) !== -1
            ? link.getAttribute('data-link-type') : 'editorial',
        });
        var courseIntent = link.getAttribute('data-course-intent');
        if (publicKind(pagePath) === 'curso' && targetPath === '/contacto' &&
            ['consulta', 'grupo', 'aviso'].indexOf(courseIntent) !== -1) {
          window.stTrack('course_contact_intent', {
            course_id: pagePath.split('/').pop(),
            intent_type: courseIntent,
            page_path: pagePath,
          });
        }
      } catch (_) { /* href no navegable */ }
    }, { capture: true });

    document.addEventListener('submit', function (e) {
      var form = e.target;
      if (publicKind(pagePath) !== 'curso' || !form.getAttribute ||
          form.getAttribute('action') !== '/api/curso-checkout') return;
      window.stTrack('course_checkout_intent', {
        course_id: pagePath.split('/').pop(),
        page_path: pagePath,
      });
    }, { capture: true });

    // ── form_start: primer foco en un campo de cualquier <form>, una vez por form.
    //    Revela dónde fuga el embudo (hoy solo se medía el submit final).
    var formsStarted = {};
    document.addEventListener('focusin', function (e) {
      var form = e.target.closest && e.target.closest('form');
      if (!form) return;
      if (!privacy || !privacy.isAllowed()) return;
      var id = form.getAttribute('id') || form.getAttribute('data-form') || 'form';
      if (!/^[a-zA-Z0-9_-]{1,80}$/.test(id)) id = 'form';
      if (formsStarted[id]) return;
      formsStarted[id] = true;
      window.stTrack('form_start', { form_id: id, page_path: location.pathname });
    }, { capture: true });

    // CTA clicks delegated
    document.addEventListener('click', function (e) {
      var el = e.target.closest && e.target.closest('[data-track]');
      if (!el) return;
      var kind = el.getAttribute('data-track');

      if (kind === 'cta') {
        window.stTrack('cta_click', {
          cta_id: el.getAttribute('data-track-id') || '',
          page_path: location.pathname,
        });
        return;
      }

      if (kind === 'download') {
        var href = el.getAttribute('href') || '';
        var ext = '';
        try { ext = new URL(href, location.origin).pathname.split('.').pop().toLowerCase(); } catch (_) {}
        if (!/^(pdf|docx?|xlsx?|csv|zip|pptx?)$/.test(ext)) ext = 'other';
        window.stTrack('file_download', {
          file_extension: ext,
          page_path: pagePath,
        });
        return;
      }
    }, { capture: true });
  })();
</script>
