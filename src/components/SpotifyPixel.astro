---
// Spotify Pixel para atribuir visitas y conversiones de campañas.
// Solo se carga con consentimiento explícito, en páginas públicas sin query/hash.
const spotifyPixelId = '18ec3e2261264ed991f8ba10a2d90161';
---

{spotifyPixelId && (
  <script is:inline define:vars={{ spotifyPixelId }}>
    (function () {
      var loaded = false;

      function canLoad() {
        var privacy = window.stPrivacy;
        return privacy && typeof privacy.isAllowed === 'function' && privacy.isAllowed() &&
          !privacy.hasSensitiveContext && !location.search && !location.hash;
      }

      function loadSpotifyPixel() {
        if (loaded || !spotifyPixelId || !canLoad()) return;
        loaded = true;
        window.stNonessentialLoaded = true;

        (function (w, d) {
          var id = 'spdt-capture';
          var tag = 'script';
          if (!d.getElementById(id)) {
            w.spdt = w.spdt || function () {
              (w.spdt.q = w.spdt.q || []).push(arguments);
            };
            var script = d.createElement(tag);
            script.id = id;
            script.async = true;
            script.referrerPolicy = 'no-referrer';
            script.src = 'https://pixel.byspotify.com/ping.min.js';
            var firstScript = d.getElementsByTagName(tag)[0];
            firstScript.parentNode.insertBefore(script, firstScript);
          }

          w.spdt('conf', { key: spotifyPixelId });
          w.spdt('view');
        })(window, document);
      }

      loadSpotifyPixel();
      document.addEventListener('cookieconsent:all', loadSpotifyPixel);
    })();
  </script>
)}
