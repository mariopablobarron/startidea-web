---
/**
 * CursoRelacionado.astro
 *
 * Enlaza UNA formación del Lab desde notas editoriales seleccionadas bajo
 * una regla estricta de asociación: ARTICLE → RELEVANT COURSE (CURSO_POR_NOTA).
 * Sin slug o si el curso no existe o es draft, no renderiza nada.
 */
import { getCollection } from 'astro:content';

interface Props {
  /** Selección editorial explícita; no se sustituye por otro curso. */
  slug?: string;
}

const { slug } = Astro.props;

const cursos = await getCollection('cursos', ({ data }) => !data.draft);
const curso = slug ? cursos.find((c) => c.slug === slug) : undefined;

const ESTADO_LABEL: Record<string, string> = {
  abierto: 'Inscripción abierta',
  proximo: 'Próxima edición',
  agotado: 'Plazas agotadas',
  'a-demanda': 'Fecha a demanda',
};

const fmtFecha = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const hoy = new Date();
hoy.setHours(0, 0, 0, 0);
const edicion = curso?.data.proxima_edicion;

const cuando =
  edicion && edicion.valueOf() >= hoy.valueOf()
    ? fmtFecha.format(edicion)
    : (ESTADO_LABEL[curso?.data.estado ?? ''] ?? null);

const duracion = curso ? curso.data.duracion.split('(')[0].trim() : null;
const precio = curso ? `${curso.data.precio} €` : null;
const precioEsfl = curso?.data.precio_esfl != null ? `${curso.data.precio_esfl} € para ESFL` : null;
---

{curso && (
  <section class="border-y border-ink/15 bg-paper py-12">
    <div class="container-narrow flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
      <div>
        <span class="font-mono text-[10px] uppercase tracking-widest text-magenta">— Formación relacionada</span>
        <h2 class="mt-2 font-display text-xl leading-tight text-ink md:text-2xl">{curso.data.title}</h2>
        <p class="mt-3 max-w-measure text-sm leading-relaxed text-ink/75">
          {curso.data.description}
        </p>
        <ul class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px] uppercase tracking-widest text-ink/75">
          {cuando && <li>{cuando}</li>}
          {duracion && <li>{duracion}</li>}
          {precio && <li>{precio}</li>}
        </ul>
        {precioEsfl && <p class="mt-2 text-xs text-ink/70">{precioEsfl}</p>}
      </div>
      <a
        href={`/laboratorio/cursos/${curso.slug}`}
        data-link-type="curso"
        class="inline-block self-start whitespace-nowrap border-2 border-ink bg-paper px-5 py-3 font-mono text-[11px] uppercase tracking-widest text-ink transition-colors hover:border-magenta hover:text-magenta md:self-auto"
      >
        Ver la formación →
      </a>
    </div>
  </section>
)}
