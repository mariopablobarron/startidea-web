---
// Microsoft Clarity (heatmaps + session replay).
// Solo se carga con consentimiento explícito, en páginas públicas y sin
// parámetros de URL: el SDK registra la URL por su cuenta. ID configurable;
// fallback al ID actual de startidea.es para no romper si falta env.
const clarityId =
  import.meta.env.PUBLIC_CLARITY_ID || '83cb1d3176084574bd2a99701400aceb';
---

{clarityId && (
  <script is:inline define:vars={{ clarityId }}>
    (function () {
      var loaded = false;

      function canLoad() {
        var privacy = window.stPrivacy;
        return privacy && typeof privacy.isAllowed === 'function' && privacy.isAllowed() &&
          !privacy.hasSensitiveContext && !location.search && !location.hash;
      }

      function loadClarity() {
        if (loaded || !clarityId || !canLoad()) return;
        loaded = true;
        window.stNonessentialLoaded = true;
        (function (c, l, a, r, i, t, y) {
          c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
          t = l.createElement(r);
          t.async = 1;
          t.referrerPolicy = 'no-referrer';
          t.src = 'https://www.clarity.ms/tag/' + i;
          y = l.getElementsByTagName(r)[0];
          y.parentNode.insertBefore(t, y);
        })(window, document, 'clarity', 'script', clarityId);
      }

      loadClarity();
      document.addEventListener('cookieconsent:all', loadClarity);
    })();
  </script>
)}
