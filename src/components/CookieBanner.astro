---
// Banner de consentimiento minimalista, RGPD-friendly.
// Estados guardados en localStorage: 'all' | 'essential'.
// Dispara el evento `cookieconsent:all` cuando se aceptan terceros.
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[60] hidden border-t-2 border-ink bg-paper shadow-[0_-12px_40px_-16px_rgba(0,0,0,0.18)]"
  role="dialog"
  aria-live="polite"
  aria-label="Aviso de cookies"
>
  <div class="container-x py-5 md:py-6">
    <div class="grid grid-cols-12 items-center gap-x-6 gap-y-4">
      <div class="col-span-12 lg:col-span-7">
        <p class="label">— Cookies</p>
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink/85">
          Este sitio usa cookies técnicas (necesarias para que el sitio funcione) y, si tú quieres, cookies de terceros para cargar el calendario de Cal.com y medir la web con Google Analytics, Microsoft Clarity y Spotify Pixel.
          <a href="/cookies" class="link-underline text-ink">Más detalles</a>.
        </p>
        <p id="cookie-reload-notice" hidden class="mt-3 max-w-2xl text-sm leading-relaxed text-ink/85">
          Al cambiar a solo esenciales se recargará la página. Guarda antes lo que hayas escrito.
        </p>
      </div>
      <div class="col-span-12 flex flex-wrap items-center justify-start gap-3 lg:col-span-5 lg:justify-end">
        <button id="cookie-reject" type="button" class="btn-ghost">
          Solo esenciales
        </button>
        <button id="cookie-accept" type="button" class="btn">
          Aceptar todas
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = 'startidea.cookieconsent.v2';
    var banner = document.getElementById('cookie-banner');
    if (!banner) return;
    var reloadNotice = document.getElementById('cookie-reload-notice');

    function emit(value) {
      try {
        document.dispatchEvent(new CustomEvent('cookieconsent:' + value));
      } catch (_) {}
    }

    function save(value) {
      var previous = current;
      var hadNonessential = window.stNonessentialLoaded === true;
      try {
        localStorage.setItem(KEY, value);
      } catch (_) {
        // Si falla la escritura al revocar, no conservar un «all» antiguo
        // que volvería a activar los SDK al recargar.
        if (value === 'essential') {
          try { localStorage.removeItem(KEY); } catch (_) {}
        }
      }
      current = value;
      banner.classList.add('hidden');
      emit(value);
      // Un SDK ya ejecutado conserva listeners aunque se retire su <script>.
      // Recargar tras revocar corta esa instancia; la nueva página no lo carga.
      if (previous === 'all' && value === 'essential' && hadNonessential) {
        window.location.reload();
      }
    }

    var current = null;
    try {
      current = localStorage.getItem(KEY);
    } catch (_) {}

    if (current === 'all' || current === 'essential') {
      banner.classList.add('hidden');
      // Re-emite el estado para que los listeners que se añaden después sepan dónde estamos.
      setTimeout(function () { emit(current); }, 0);
    } else {
      banner.classList.remove('hidden');
    }

    var accept = document.getElementById('cookie-accept');
    var reject = document.getElementById('cookie-reject');
    if (accept) accept.addEventListener('click', function () { save('all'); });
    if (reject) reject.addEventListener('click', function () { save('essential'); });

    // API mínima para que otras páginas puedan reabrir el banner.
    window.startideaConsent = {
      get: function () { try { return localStorage.getItem(KEY); } catch (_) { return null; } },
      reopen: function () {
        if (reloadNotice) reloadNotice.hidden = !(current === 'all' && window.stNonessentialLoaded === true);
        banner.classList.remove('hidden');
      },
    };
  })();
</script>
